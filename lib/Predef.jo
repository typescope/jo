namespace jo

import jo.compile.intrinsic
import jo.compile.SourceLocation

//------------------------------------------------------------------------------
// Basic types
//
// `Any` and `Bottom` are handled specially in the namer

//[ The top type: every value is an `Any`
  !
  ! Nothing can be done with an `Any` except pass it on; recover a usable type
  ! with a `match` or a cast. Handled specially in the namer.
//]
type Any

//[ The bottom type: no value has this type
  !
  ! It is the result type of an expression that never returns normally, such as
  ! `abort`. Because it is a subtype of every type, such an expression can stand
  ! anywhere a value is expected. Handled specially in the namer.
//]
type Bottom

//------------------------------------------------------------------------------
//
// Patterns
//

// A type to indicate that a pattern predicate does not exhaust a type
type Partial[T] = T

//[ "|" pattern
  !
  ! The branches of an OR pattern must bind the same set of variables.
  !
  ! Its true semantics is handled in pattern translation.
//]
@intrinsic
pattern (lhs: T) |[T] (rhs: T): T =
  case lhs @ rhs

//[ "&" pattern
  !
  !  The pattern is intrinsified in pattern translation.
//]
@intrinsic
pattern (lhs: T) &[T] (rhs: T): T =
  case lhs @ rhs

//[ "!" pattern
  !
  ! The bounded variables in the nested pattern will disappear from the flow
  ! scope and not available for later patterns.
  !
  ! The pattern is intrinsified in pattern translation.
//]
@intrinsic
pattern ![T] (pat: T): T =
  case pat

//------------------------------------------------------------------------------
//
// Varargs support
//

// Used to indicate the last parameter is a vararg
type ..[T] = List[T]

//------------------------------------------------------------------------------
//
// Utility functions
//

//[ Write `s` to standard output, with no trailing newline
  !
  ! Accepts anything printable, so `print 42` needs no conversion. Requires the
  ! `IO.stdout` capability.
//]
def print(s: StringLike): Unit = IO.stdout s

//[ Write `s` to standard output, followed by a newline
  !
  ! Accepts anything printable, so `println list` needs no conversion. Requires
  ! the `IO.stdout` capability.
//]
def println(s: StringLike): Unit =
  print s
  print '\n'

//[ Placeholder for an unwritten body; aborts with "not implemented" if reached
  !
  ! Its type is `Bottom`, so it type-checks wherever a value is expected:
  !
  !     def area(shape: Shape): Float = ...
  !
  ! The diagnostic includes the source location of the placeholder.
//]
def ...(auto location: SourceLocation): Bottom = abort("not implemented")

private defer def abortImpl(s: String): Bottom

//[ Terminate the program with the message `s`, followed by `(file:line)`
  !
  ! Returns `Bottom`, so a call can stand in for a value of any type. This is
  ! an unrecoverable exit, not an exception: there is nothing to catch.
  ! The auto location is supplied at the call site, or forwarded from an
  ! enclosing auto `SourceLocation` parameter.
//]
def abort(s: String)(auto location: SourceLocation): Bottom =
  abortImpl(s + " (" + location + ")")

//[ Abort with the message from `error` unless `cond` holds
  !
  ! `error` is only called when the check fails. A location requested inside
  ! the message is therefore constructed only on failure:
  !
  !     assert(cond, "check failed (" + compile.location + ")")
//]
def assert(cond: Bool, error: () => String): Unit =
  if !cond then abortImpl(error())

//------------------------------------------------------------------------------
//
// Annotations
//

//[ Mark an extension method as intentionally shadowing a base-type member
  !
  ! When an extension method has the same name as a member of its base type,
  ! the compiler warns unless the method is annotated with `@shadow`.
  !
  ! Example:
  !
  !   extension IntExt for Int
  !     @shadow def toString: String = "custom"
  !   end
//]
annotation shadow

//[ Mark a definition whose result may be discarded without a warning
  !
  ! Dropping a value is usually a mistake, so the compiler warns about it. A
  ! method that returns its own receiver, so that calls can be chained, has
  ! nothing to say when the result is ignored: the caller already holds it.
  !
  ! Example:
  !
  !   @discardableResult
  !   def add(v: T): ListBuilder[T] = ...
  !
  !     builder.add 1          // a statement on its own, and no warning
  !     builder.add(1).add 2   // still chains
//]
annotation discardableResult
