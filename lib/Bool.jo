namespace jo

import jo.compile.intrinsic

//[ The truth values `true` and `false`
  !
  ! `&&` and `||` short-circuit: the right operand is only evaluated when the
  ! left one does not already decide the result.
//]
@intrinsic
class Bool
  private def Bool() = abort "Cannot create new Bool instance"

  //[ Follows short-cut semantics
    !
  //]
  @intrinsic
  def &&(other: Bool): Bool = ...

  //[ Follows short-cut semantics
    !
  //]
  @intrinsic
  def ||(other: Bool): Bool = ...

  //[ True if the two values are equal. //]
  @intrinsic
  def ==(other: Bool): Bool = ...

  //[ True if the two values differ. //]
  def !=(other: Bool): Bool = ! (this == other)

  //[ Either `"true"` or `"false"`. //]
  @intrinsic
  def toString: String = ...

  //[ Prefix operator !
    !
    ! The tilde is a marker for prefix operator method
  //]
  @intrinsic
  def ~! : Bool = ...
end
