namespace jo

//[ A builder sized for `capacity` elements.
  !
  ! Reach for `List.builder` instead unless the final length is already known:
  ! a caller filling a builder by hand does not know it, and a wrong guess only
  ! costs the builder a copy.
  !
  ! The typer starts the chain it lowers a list literal to here, where the
  ! length *is* known. That call lands in the user's own namespace, so this
  ! cannot be `private[jo]`.
//]
def ListBuilder[T](capacity: Int = 8): ListBuilder[T] =
  new ListBuilder(capacity)

//[ Incrementally builds a `List`, filling the array it will use.
  !
  ! Reach for a builder whenever the elements of a list arrive one at a time:
  !
  !     val evens = List.builder[Int]()
  !     for v in source do
  !       if v % 2 == 0 then
  !         evens += v
  !     evens.result
  !
  ! The alternative, `acc = acc + v` in a loop, is O(1) amortized as well, but
  ! it allocates a new `List` for every element and, on some backends, asks the
  ! runtime whether it may write the next slot. A builder writes each element
  ! straight into the array the list will use.
  !
  ! Prefer, in order:
  !
  !   - `[a, b, c]` when the elements are written out literally,
  !   - `List.fill` / `List.tabulate` when the length is known up front and the
  !     elements are a function of the index, since they size the array exactly,
  !   - a builder for everything else,
  !   - `+` only to append to a list that already exists.
  !
  ! Why `add` hands the builder back
  ! --------------------------------
  !
  ! `add`, `addAll` and `addList` return the builder and are marked
  ! `@discardableResult`, so they chain and still read as statements. That shape
  ! is here for the typer, which lowers a vararg pack to a single expression:
  !
  !     [a, ..xs, b]  ~>  ListBuilder[T](n).add(a).addList(xs).add(b).result
  !
  ! It needs no local binding only because each call returns the builder.
  !
  ! This is not a template to copy. An ordinary mutating method should return
  ! `Unit`, as `mutable.Set.add` and `mutable.List.append` do: a method that
  ! returns `this` reads at the call site exactly like the pure operation of the
  ! same name. In a loop, prefer `+=` and `++=` here too.
  !
  ! One result per builder
  ! -----------------------
  !
  ! `result` hands the builder's array to the list it returns, and that list
  ! may later append into the free slots past its end. So a builder is done
  ! once `result` is called. Adding to it afterwards aborts. Calling `result`
  ! again returns a list that cannot append in place, so no two lists ever
  ! write the same slots.
//]
class ListBuilder[T]
  // The elements are `arr[0]` to `arr[count - 1]`.
  private var arr: Array[T]
  private var count: Int

  // Whether `result` has been called.
  private var finished: Bool

  private[jo] def ListBuilder(capacity: Int) =
    this.arr = Array.create[T](if capacity > 0 then capacity else 8)
    this.count = 0
    this.finished = false

  //[ Number of elements added so far. //]
  def size: Int = count

  //[ Append one element.
    !
    ! This is the form to reach for in a loop, where the builder is a statement
    ! rather than part of an expression. `add` is the same thing for a caller
    ! that wants the builder back to go on chaining.
  //]
  def +=(v: T): Unit =
    reserve 1
    arr[count] = v
    count = count + 1

  //[ Append every element of `source`, which is consumed.
    !
    ! Anything the language can iterate can be added this way, since
    ! collections all provide an `iterator`:
    !
    !     b ++= someMap
  //]
  def ++=(source: Iterator[T] :- [.iterator]): Unit =
    while source.hasNext do
      this += source.next

  //[ Append one element and return this builder. //]
  @discardableResult
  def add(v: T): ListBuilder[T] =
    this += v
    this

  //[ Append every element of `source` and return this builder.
    !
    ! `source` is consumed. Anything the language can iterate can be added this
    ! way, since collections all provide an `iterator`:
    !
    !     b.addAll someMap
  //]
  @discardableResult
  def addAll(source: Iterator[T] :- [.iterator]): ListBuilder[T] =
    this ++= source
    this

  //[ Append every element of `l` and return this builder.
    !
    ! `addAll` covers this and more; the typer calls this one when it lowers a
    ! spliced vararg, where the argument is known to be a list.
  //]
  @discardableResult
  def addList(l: List[T]): ListBuilder[T] =
    reserve l.size
    l.copyTo(arr, count)
    count = count + l.size
    this

  // Make room for `n` more elements. Every addition comes through here, so
  // this is also where a finished builder refuses more.
  private def reserve(n: Int): Unit =
    if finished then
      abort "ListBuilder: cannot add after `result`"

    if count + n > arr.size then
      val grown = Array.create[T](ListImpl.grownCapacity(count + n, count))
      var i = 0
      while i < count do
        grown[i] = arr[i]
        i = i + 1
      end
      arr = grown

  //[ The list of everything added.
    !
    ! This finishes the builder: adding to it afterwards aborts. Calling
    ! `result` again returns a list of the same elements.
  //]
  def result: List[T] =
    if finished then
      // The first result may append into the free slots past `count`, so this
      // one must not: its claim starts full, and it copies when it appends.
      new List(arr, 0, count, ListImpl.newClaim(arr.size))

    else
      finished = true

      // Hand over `arr` unless most of it is still free: a short list would
      // otherwise hold on to a long array for good.
      if count * 2 < arr.size then
        val exact = Array.create[T](count)
        var i = 0
        while i < count do
          exact[i] = arr[i]
          i = i + 1
        end
        ListImpl.wrap(exact, count)
      else
        ListImpl.wrap(arr, count)
end
