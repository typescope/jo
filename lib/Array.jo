namespace jo

import jo.compile.intrinsic

//------------------------------------------------------------------------------
//
// Arrays
//

//[ A generic Array of value
  !
  ! The boxing behavior of primitive values is platform-dependent. Such boxing
  ! behavior only matters for performance, not for type safety.
  !
  ! Trusted code can use FFI to access more efficient primitive arrays if they
  ! are available for the particular platform.
//]
@intrinsic
class Array[T]
  private def Array() = abort("Invalid Array creation")

  //[ The element at index `i`, 0-based.
    !
    ! The index is not bounds-checked. An out-of-range access fails with a
    ! backend-level error rather than a Jo `abort`, so prefer `mutable.List`
    ! where the index is not already known to be valid.
  //]
  @intrinsic
  def get(i: Int): T = ...

  //[ The number of elements. Fixed when the array is created. //]
  @intrinsic
  def size: Int = ...

  //[ Store `value` at index `i`, 0-based. The index is not bounds-checked. //]
  @intrinsic
  def set(i: Int, value: T): Unit = ...

  //[ Return a new array with the same length and the same elements.
    !
    ! The copy is shallow: elements themselves are not copied.
  //]
  @intrinsic
  def clone: Array[T] = ...

  //[ Return a string representation, e.g. `[1, 2, 3]`. Shows at most 100 elements. //]
  def toString(auto elementShow: Show[T] with [[T].toString]): String =
    // Show at most 100
    var res = "["
    var index = 0
    while index < 100 && index < this.size do
      val text = elementShow.show this[index]
      if index == 0 then
        res = res + text
      else
        res = res + ", " + text
      index = index + 1
    end
    if index == 100 then res = res + ", ..."
    res = res + "]"
    res

end

//[ Operations on `Array` that are not methods. //]
section Array
  //[ Create an array with `size` elements.
    !
    ! The elements are uninitialized. Code must not depend on any particular
    ! default value. Platforms only guarantee memory safety and security. Initialize each
    ! element before reading it, or use `Array.fill`.
  //]
  defer def create[T](size: Int): Array[T]

  //[ Clear the designated slot of the given array
    !
    ! The designated slot becomes uninitialized. Code must not depend on any
    ! particular default value. Platforms only guarantee memory safety and security.
  //]
  defer def clear[T](arr: Array[T], at: Int): Unit

  //[ Create an array containing `size` copies of `value`. //]
  def fill[T](size: Int, value: T): Array[T] =
    val arr = create[T](size)
    var i = 0
    while i < size do
      arr[i] = value
      i = i + 1
    end
    arr

  //[ Create an array by applying `values` to each index. //]
  def tabulate[T](size: Int, values: Int => T): Array[T] =
    val arr = create[T](size)
    var i = 0
    while i < size do
      arr[i] = values(i)
      i = i + 1
    end
    arr
end
