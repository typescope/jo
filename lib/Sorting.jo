namespace jo

//[ In-place sorting routines. //]
section Sorting
  //[ Sort arr[from..to] (inclusive) in-place, bottom up.
    !
    ! Time: O(n log n), Space: O(n) auxiliary. Stable sort.
  //]
  def sortArray[T](arr: Array[T], from: Int, to: Int, ord: Ord[T]): Unit =
    if from >= to then return

    val n = to - from + 1

    // Short runs first, insertion sorted in place. Eight is small enough
    // that insertion sort spends fewer compares than merging the run would.
    var start = from
    while start <= to do
      val last = start + 7
      insertionSort(arr, start, if last < to then last else to, ord)
      start = start + 8
    end

    if n > 8 then
      // One scratch array for the whole sort: each pass merges from one of
      // the two into the other, so no pass has to copy its result back.
      // Positions below are relative to `from`, whichever side they land in.
      val scratch = Array.create[T](n)
      var inScratch = false
      var width = 8

      while width < n do
        var lo = 0

        while lo < n do
          val last = lo + 2 * width - 1
          val hi = if last < n - 1 then last else n - 1
          // A run past the end of the data has no partner: clamped this way
          // the merge below finds its right side empty and moves the run
          // across as it is, which is what an unpaired run needs.
          val split = lo + width - 1
          val mid = if split < hi then split else hi

          if inScratch then
            mergeRun(scratch, 0, arr, from, lo, mid, hi, ord)
          else
            mergeRun(arr, from, scratch, 0, lo, mid, hi, ord)

          lo = lo + 2 * width
        end

        inScratch = !inScratch
        width = width * 2
      end

      if inScratch then
        var i = 0
        while i < n do
          arr[from + i] = scratch[i]
          i = i + 1

  //[ Sort arr[from..to] (inclusive) in place by insertion. //]
  private def insertionSort[T](arr: Array[T], from: Int, to: Int, ord: Ord[T]): Unit =
    var i = from + 1
    while i <= to do
      val v = arr[i]
      var j = i - 1

      // Strictly greater, so equal elements keep their order.
      while j >= from && ord.compare(arr[j], v) > 0 do
        arr[j + 1] = arr[j]
        j = j - 1
      end

      arr[j + 1] = v
      i = i + 1

  // Merge src[lo..mid] and src[mid+1..hi] into dst[lo..hi], with each side's
  // positions taken from its own base. A run past the end of the data has no
  // partner to merge with and is moved across as it is.
  private def mergeRun[T](src: Array[T], srcBase: Int, dst: Array[T], dstBase: Int, lo: Int, mid: Int, hi: Int, ord: Ord[T]): Unit =
    var li = lo
    var ri = mid + 1
    var k = lo

    while li <= mid && ri <= hi do
      val left = src[srcBase + li]
      val right = src[srcBase + ri]

      if ord.compare(left, right) <= 0 then
        dst[dstBase + k] = left
        li = li + 1
      else
        dst[dstBase + k] = right
        ri = ri + 1

      k = k + 1
    end

    while li <= mid do
      dst[dstBase + k] = src[srcBase + li]
      li = li + 1
      k = k + 1
    end

    while ri <= hi do
      dst[dstBase + k] = src[srcBase + ri]
      ri = ri + 1
      k = k + 1
    end

  //[ Sort `l`, returning a new list. Time: O(n log n), Space: O(n) auxiliary.
    ! Stable sort.
  //]
  private[jo] def sortList[T](l: List[T])(auto ord: Ord[T]): List[T] =
    val n = l.size
    val arr = Array.create[T](n)
    l.copyTo(arr, 0)
    sortArray(arr, 0, n - 1, ord)
    ListImpl.wrap(arr, n)
end
