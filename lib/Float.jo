namespace jo

import jo.compile.intrinsic

//[ 64-bit IEEE 754 floating-point numbers
  !
  ! Float is a class (like String) to avoid operator namespace pollution.
  !
  ! Not available on the 32-bit native backends: compiling any use of `Float`
  ! with `--reg` or `--stack` fails with "Floating point not supported for
  ! native backend". The 64-bit `--llvm` backend supports it.
  !
  ! IEEE 754 semantics apply, so `0.0 / 0.0` is NaN and NaN compares false
  ! against every value, itself included.
//]
@intrinsic
class Float
  private def Float() = abort "Cannot create new Float instance"

  // Arithmetic operators as methods
  //[ Floating-point addition. //]
  @intrinsic
  def +(other: Float): Float = ...

  //[ Floating-point subtraction. //]
  @intrinsic
  def -(other: Float): Float = ...

  //[ Floating-point multiplication. //]
  @intrinsic
  def *(other: Float): Float = ...

  //[ Floating-point division. Division by zero yields an infinity or NaN, never an abort. //]
  @intrinsic
  def /(other: Float): Float = ...

  // Comparison operators as methods
  //[ True if this value is greater than `other`. //]
  @intrinsic
  def >(other: Float): Bool = ...

  //[ True if this value is less than `other`. //]
  @intrinsic
  def <(other: Float): Bool = ...

  //[ True if this value is greater than or equal to `other`. //]
  @intrinsic
  def >=(other: Float): Bool = ...

  //[ True if this value is less than or equal to `other`. //]
  @intrinsic
  def <=(other: Float): Bool = ...

  //[ True if the two values are equal. //]
  @intrinsic
  def ==(other: Float): Bool = ...

  //[ True if the two values differ. //]
  @intrinsic
  def !=(other: Float): Bool = ! (this == other)

  // Prefix negation
  @intrinsic
  def ~-(): Float = ...

  //[ Nearest integral Float, with halfway values rounded away from zero.
    !
    ! Supports positive and negative values across the full Float range.
    ! NaN returns NaN. Infinities and signed zeros are unchanged.
    ! Results that round to zero keep the input's sign.
  //]
  def round: Float =
    val negative = this < 0.0
    val magnitude = if negative then -this else this
    val lower = magnitude.floor
    val nearest = if magnitude - lower >= 0.5 then lower + 1.0 else lower
    if negative then -nearest else nearest

  //[ Greatest integral Float less than or equal to this value.
    !
    ! Supports positive and negative values across the full Float range.
    ! NaN returns NaN. Infinities and signed zeros are unchanged.
  //]
  def floor: Float =
    // At magnitudes of 2^52 or greater, all finite Floats are integral.
    if this != this || this == 0.0 then this
    else if this >= 4503599627370496.0 || this <= -4503599627370496.0 then this
    else this.floorFinite

  //[ Least integral Float greater than or equal to this value.
    !
    ! Supports positive and negative values across the full Float range.
    ! NaN returns NaN. Infinities and signed zeros are unchanged.
    ! Negative values that round to zero return negative zero.
  //]
  def ceil: Float = -((-this).floor)

  //[ Round a finite, nonzero value of magnitude less than 2^52 downward. //]
  @intrinsic
  private def floorFinite: Float = ...

  // Conversion methods
  //[ Truncates toward zero. //]
  @intrinsic
  def toInt: Int = ...

  //[ Truncate toward zero to a signed 64-bit integer.
    !
    ! Values at or above 2^63, including positive infinity, return 2^63 - 1.
    ! Values at or below -2^63, including negative infinity, return -2^63.
    ! NaN returns 0. Both positive and negative finite values are supported.
  //]
  def toLong: Long =
    if this != this then 0
    else if this >= 9223372036854775808.0 then 9223372036854775807
    else if this <= -9223372036854775808.0 then -9223372036854775808
    else this.truncateToLong

  //[ Convert a finite value strictly between -2^63 and 2^63.
    !
    ! `toLong` handles NaN and saturation before calling this primitive.
  //]
  @intrinsic
  private def truncateToLong: Long = ...

  //[ Decimal representation. The exact spelling is backend dependent: the JavaScript backend prints `7` where the others print `7.0`. //]
  @intrinsic
  def toString: String = ...

  //[ Format this value in fixed, scientific or general decimal notation.
    !
    ! Examples:
    !
    !     12.375.format(".2f") == "12.38"
    !     12.0.format(".2e") == "1.20e+01"
    !     0.125.format(".2f") == "0.12"
    !     12.0.format(".0f") == "12"
    !     12.345.format(".4g") == "12.35"
    !     12.0.format(".4g") == "12"
    !     12345.0.format(".3g") == "1.23e+04"
    !
    ! `spec` must be "." followed by one or more ASCII decimal digits
    ! and "f", "e" or "g". The digits specify a precision from 0 to 10000.
    ! This is a subset of Python's format-specification mini-language.
    !
    ! "f" uses fixed notation, regardless of magnitude.
    ! "e" uses scientific notation with one digit before the decimal point,
    ! lowercase "e", and an exponent with a sign and at least two digits.
    ! The exponent is zero when the formatted value is zero.
    !
    ! "f" and "e" produce exactly the specified number of fractional digits,
    ! retaining trailing zeros. Precision zero omits the decimal point.
    ! "g" specifies significant digits, treating precision zero as one. It
    ! uses scientific notation if the decimal exponent after rounding is
    ! below -4 or at least the precision, and fixed notation otherwise.
    ! Trailing fractional zeros and an unnecessary decimal point are removed.
    ! Zero is "0" or "-0".
    !
    ! Conversion rounds the exact stored binary value to nearest, with
    ! halfway cases rounded to even.
    !
    ! Supports the full finite Float range, including negative values and
    ! subnormals. Negative zero and negative values rounded to zero retain
    ! their minus sign. NaN produces "nan"; infinities produce "inf" or "-inf".
    !
    ! Output uses ASCII digits and "." independently of locale and backend.
    ! Aborts if the specification is invalid or the precision exceeds 10000.
  //]
  def format(spec: String): String =
    val precision = FloatFormatting.precision(spec)

    if this != this then "nan"
    else if this - this != 0.0 then
      if this < 0.0 then "-inf" else "inf"
    else
      val bits = this.toBits
      // The sign bit also distinguishes negative zero from positive zero.
      val sign = if bits < 0 then "-" else ""
      val digits ~ point = FloatFormatting.exactDigits(bits)
      val text =
        if spec[spec.size - 1] == 'f' then FloatFormatting.fixed(digits, point, precision)
        else if spec[spec.size - 1] == 'e' then FloatFormatting.scientific(digits, point, precision)
        else FloatFormatting.general(digits, point, precision)
      sign + text

  //[ The IEEE 754 binary64 representation, interpreted as a signed Long. //]
  @intrinsic
  private def toBits: Long = ...

  //[ Return 1, -1 or 0 as this value is greater than, less than or equal to `other`. Returns 0 if either value is NaN. //]
  def compareTo(other: Float): Int =
    if this < other then -1
    else if this > other then 1
    else 0

  //[ The greater of the two values. Returns `other` if this value is NaN. //]
  def max(other: Float): Float = if this >= other then this else other
  //[ The lesser of the two values. Returns `other` if this value is NaN. //]
  def min(other: Float): Float = if this <= other then this else other
end

//[ Operations on `Float` that are not methods. //]
section Float
  //[ Backend decimal conversion. The caller must validate the syntax first. //]
  @intrinsic
  private def parseFloatDecimal(s: String): Float = ...

  //[ Parse decimal float with optional sign and exponent. Returns None on invalid input.
    !
    ! Conversion rounds directly to the nearest representable Float.
    ! Overflow yields infinity and underflow may yield signed zero.
    !
    ! Whitespaces are not allowed. Call `s.trim` first if surrounding
    ! whitespaces are allowed.
  //]
  def parse(s: String): Option[Float] =
    val n = s.size
    if n == 0 then return None

    var i = 0

    val first = s.get(0)
    if first == '+' || first == '-' then
      i = 1
    end

    var hasWhole = false
    while i < n && s.get(i) is c && c >= '0' && c <= '9' do
      hasWhole = true
      i = i + 1
    end

    var hasFrac = false
    if i < n && s.get(i) == '.' then
      i = i + 1
      while i < n && s.get(i) is c && c >= '0' && c <= '9' do
        hasFrac = true
        i = i + 1
      end
    end

    if !(hasWhole || hasFrac) then return None

    if i == n then return Some(parseFloatDecimal(s))
    if s.get(i) is a && a != 'e' && a != 'E' then return None

    i = i + 1
    if i < n then
      val c = s.get(i)
      if c == '+' || c == '-' then
        i = i + 1
      end
    end

    if i >= n || s.get(i) is c && (c < '0' || c > '9') then return None

    while i < n && s.get(i) is c && c >= '0' && c <= '9' do
      i = i + 1
    end

    if i != n then return None

    Some(parseFloatDecimal(s))
end
