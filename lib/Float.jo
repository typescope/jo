namespace jo

import jo.compile.intrinsic

//[ 64-bit IEEE 754 floating-point numbers
  !
  ! Float is a class (like String) to avoid operator namespace pollution.
  !
  ! Not available on the native backends: compiling any use of `Float` with
  ! `--reg` or `--stack` fails with "Floating point not supported for native
  ! backend".
  !
  ! IEEE 754 semantics apply, so `0.0 / 0.0` is NaN and NaN compares false
  ! against every value, itself included.
//]
@intrinsic
class Float
  private def Float() = abort "Cannot create new Float instance"

  // Arithmetic operators as methods
  //[ Floating-point addition. //]
  @intrinsic
  def +(other: Float): Float = ...

  //[ Floating-point subtraction. //]
  @intrinsic
  def -(other: Float): Float = ...

  //[ Floating-point multiplication. //]
  @intrinsic
  def *(other: Float): Float = ...

  //[ Floating-point division. Division by zero yields an infinity or NaN, never an abort. //]
  @intrinsic
  def /(other: Float): Float = ...

  // Comparison operators as methods
  //[ True if this value is greater than `other`. //]
  @intrinsic
  def >(other: Float): Bool = ...

  //[ True if this value is less than `other`. //]
  @intrinsic
  def <(other: Float): Bool = ...

  //[ True if this value is greater than or equal to `other`. //]
  @intrinsic
  def >=(other: Float): Bool = ...

  //[ True if this value is less than or equal to `other`. //]
  @intrinsic
  def <=(other: Float): Bool = ...

  //[ True if the two values are equal. //]
  @intrinsic
  def ==(other: Float): Bool = ...

  //[ True if the two values differ. //]
  @intrinsic
  def !=(other: Float): Bool = ! (this == other)

  // Prefix negation
  @intrinsic
  def ~-(): Float = ...

  // Conversion methods
  //[ Truncates toward zero. //]
  @intrinsic
  def toInt: Int = ...

  //[ Truncate toward zero to a signed 64-bit integer.
    !
    ! Values at or above 2^63, including positive infinity, return 2^63 - 1.
    ! Values at or below -2^63, including negative infinity, return -2^63.
    ! NaN returns 0. Both positive and negative finite values are supported.
  //]
  def toLong: Long =
    if this != this then 0
    else if this >= 9223372036854775808.0 then 9223372036854775807
    else if this <= -9223372036854775808.0 then -9223372036854775808
    else this.truncateToLong

  // Convert a finite value strictly between -2^63 and 2^63.
  // `toLong` handles NaN and saturation before calling this primitive.
  @intrinsic
  private def truncateToLong: Long = ...

  //[ Decimal representation. The exact spelling is backend dependent: the JavaScript backend prints `7` where the others print `7.0`. //]
  @intrinsic
  def toString: String = ...

  //[ Return 1, -1 or 0 as this value is greater than, less than or equal to `other`. Returns 0 if either value is NaN. //]
  def compareTo(other: Float): Int =
    if this < other then -1
    else if this > other then 1
    else 0

  //[ The greater of the two values. Returns `other` if this value is NaN. //]
  def max(other: Float): Float = if this >= other then this else other
  //[ The lesser of the two values. Returns `other` if this value is NaN. //]
  def min(other: Float): Float = if this <= other then this else other
end

//[ Operations on `Float` that are not methods. //]
section Float
  //[ Backend decimal conversion. The caller must validate the syntax first. //]
  @intrinsic
  private def parseFloatDecimal(s: String): Float = ...

  //[ Parse decimal float with optional sign and exponent. Returns None on invalid input.
    !
    ! Conversion rounds directly to the nearest representable Float.
    ! Overflow yields infinity and underflow may yield signed zero.
    !
    ! Whitespaces are not allowed. Call `s.trim` first if surrounding
    ! whitespaces are allowed.
  //]
  def parse(s: String): Option[Float] =
    val n = s.size
    if n == 0 then return None

    var i = 0

    val first = s.get(0)
    if first == '+' || first == '-' then
      i = 1
    end

    var hasWhole = false
    while i < n && s.get(i) is c && c >= '0' && c <= '9' do
      hasWhole = true
      i = i + 1
    end

    var hasFrac = false
    if i < n && s.get(i) == '.' then
      i = i + 1
      while i < n && s.get(i) is c && c >= '0' && c <= '9' do
        hasFrac = true
        i = i + 1
      end
    end

    if !(hasWhole || hasFrac) then return None

    if i == n then return Some(parseFloatDecimal(s))
    if s.get(i) is a && a != 'e' && a != 'E' then return None

    i = i + 1
    if i < n then
      val c = s.get(i)
      if c == '+' || c == '-' then
        i = i + 1
      end
    end

    if i >= n || s.get(i) is c && (c < '0' || c > '9') then return None

    while i < n && s.get(i) is c && c >= '0' && c <= '9' do
      i = i + 1
    end

    if i != n then return None

    Some(parseFloatDecimal(s))
end
