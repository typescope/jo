namespace jo

import jo.ListImpl.*


//[ Create a list from variadic arguments.
  !
  ! Example: `List(1, 2, 3)` produces `[1, 2, 3]`
//]
def List[T](elems: ..T): List[T] = elems

//[ Pattern match on list
  !
  ! This pattern is useful when the scrutinee is a union type with List as a
  ! component.
//]
pattern List[T](elems: List[T]): List[T] = case elems

//[ Ways to build a `List` other than the `[...]` literal. //]
section List
  //[ An empty list. //]
  def empty[T]: List[T] =
    ListImpl.wrap(Array.create[T](0), 0)

  //[ Start building a list one element at a time.
    !
    ! See `ListBuilder` for when to prefer this over `+`, `fill` or `tabulate`.
  //]
  def builder[T]: ListBuilder[T] =
    new ListBuilder(capacity = 8)


  //[ Create a list of `n` copies of `value`. //]
  def fill[T](n: Int, value: T): List[T] =
    ListImpl.fromGenerator(n, i => value)

  //[ Create a list of `n` elements by applying `f` to each index `0..n-1`. //]
  def tabulate[T](n: Int, f: Int => T): List[T] =
    ListImpl.fromGenerator(n, f)
end

//[ An immutable indexed sequence backed by a flat array.
  !
  !   - `get(i)`: O(1)
  !   - `updated(i, v)`: O(n), as it copies the list
  !   - `slice`, `take`, `drop`: O(1) by sharing the elements, or O(k) for a
  !     result of k elements too small to be worth keeping the array alive
  !   - `+` (append one element): O(1) amortized
  !   - `++` (concatenate): O(m) amortized, where m = size of the argument
  !
  ! Appending is O(1) only while each list is extended once: of `l + a` and
  ! `l + b`, the second copies all of `l`. Build a list with the `[]` literal,
  ! with `fill`, `tabulate` or `map`, with a `ListBuilder`, or by appending with
  ! `+`. For a sequence that changes in place, use `mutable.List`.
  ! Use `for v in list` or `iterator` for O(n) traversal.
//]
class List[T]
  // The elements are `arr[start]` to `arr[start + _size - 1]`. Other lists may
  // share `arr` and see more of it; `claim` decides which of them may write
  // the free slots past the end. See `ListImpl.Claim`.
  private val arr: Array[T]
  private val start: Int
  private val _size: Int
  private val claim: ListImpl.Claim

  private[jo] def List(arr: Array[T], start: Int, size: Int, claim: ListImpl.Claim) =
    this.arr = arr
    this.start = start
    this._size = size
    this.claim = claim

  //[ Number of elements. //]
  def size: Int receives none = _size

  //[ Number of elements (alias for `size`). //]
  def length: Int receives none = _size

  //[ True if the list has no elements. //]
  def isEmpty: Bool = _size == 0

  //[ Returns an iterator over the elements in order. //]
  def iterator: Iterator[T] = new ListImpl.ListIterator(arr, start, start + _size)

  //[ Return the element at index `i` (0-based). Aborts if out of bounds. //]
  def get(i: Int): T receives none =
    if i < 0 || i >= _size then errorIndex i
    arr[start + i]

  // Copy the elements into `dest`, starting at index `at`.
  private[jo] def copyTo(dest: Array[T], at: Int): Unit receives none =
    var i = 0
    while i < _size do
      dest[at + i] = arr[start + i]
      i = i + 1

  //[ Return a new list with the element at index `i` replaced by `value`. Aborts if out of bounds.
    !
    ! This copies the whole list, so it is O(n). To change elements by index,
    ! use `mutable.List` instead.
  //]
  def updated(i: Int, value: T): List[T] =
    if i < 0 || i >= _size then errorIndex i
    val out = Array.create[T](_size)
    this.copyTo(out, 0)
    out[i] = value
    wrap(out, _size)

  //[ Append one element to the end. //]
  def +(v: T): List[T] =
    val stop = start + _size

    if stop < arr.size && tryExtend(claim, stop, 1) then
      arr[stop] = v
      new List(arr, start, _size + 1, claim)
    else
      val grown = Array.create[T](grownCapacity(_size + 1, _size))
      this.copyTo(grown, 0)
      grown[_size] = v
      new List(grown, 0, _size + 1, newClaim(_size + 1))

  //[ Concatenate two lists. O(m) amortized for m = `l.size`. //]
  def ++(l: List[T]): List[T] =
    val m = l.size
    val stop = start + _size

    if m == 0 then this
    else if _size == 0 then l
    else if stop + m <= arr.size && tryExtend(claim, stop, m) then
      l.copyTo(arr, stop)
      new List(arr, start, _size + m, claim)
    else
      val grown = Array.create[T](grownCapacity(_size + m, _size))
      this.copyTo(grown, 0)
      l.copyTo(grown, _size)
      new List(grown, 0, _size + m, newClaim(_size + m))

  //[ Return a sublist starting at index `from` with at most `len` elements.
    !
    ! The sublist shares the elements with this list, unless it is small enough
    ! that holding on to the whole array would waste more than it saves.
  //]
  def slice(from: Int, len: Int): List[T] receives none =
    val first = if from > 0 then from else 0

    if first >= _size || len <= 0 then []
    else
      val n = if _size - first > len then len else _size - first

      if n == _size then this
      else if n * 4 >= arr.size then new List(arr, start + first, n, claim)
      else
        val out = Array.create[T](n)
        var i = 0
        while i < n do
          out[i] = arr[start + first + i]
          i = i + 1
        end
        wrap(out, n)

  //[ Return the first `n` elements. //]
  def take(n: Int): List[T] receives none =
    if n <= 0 then []
    else if n >= _size then this
    else this.slice(0, n)

  //[ Drop the first `n` elements and return the rest. //]
  def drop(n: Int): List[T] receives none =
    if n <= 0 then this
    else if n >= _size then []
    else this.slice(n, _size - n)

  //[ Return elements satisfying `pred`. //]
  def select(pred: T => Bool): List[T] =
    val kept = List.builder[T]()

    for v in this if pred v do
      kept += v

    kept.result

  //[ Return elements not satisfying `pred`. //]
  def exclude(pred: T => Bool): List[T] =
    val kept = List.builder[T]()

    for v in this if !(pred v) do
      kept += v

    kept.result

  //[ Apply `f` to each element and return the resulting list. //]
  def map[S](f: T => S): List[S] =
    val out = Array.create[S](_size)
    var i = 0
    while i < _size do
      out[i] = f(arr[start + i])
      i = i + 1
    end
    wrap(out, _size)

  //[ Reduce the list to a single value using a left fold. //]
  def fold[S](zero: S, f: (S, T) => S): S =
    var acc = zero

    for v in this do
      acc = f acc v

    acc

  //[ Join elements into a string with `separator` between each pair. //]
  def join(separator: String)(auto elementShow: Show[T] with [[T].toString]): String =
    var res = ""
    var first = true
    val iter = this.iterator
    while iter.hasNext do
      val text = elementShow.show iter.next()
      if first then
        res = text
        first = false
      else
        res = res + separator + text
    end
    res

  //[ True if at least one element satisfies `pred`. //]
  def exists(pred: T => Bool): Bool =
    var qualify = false

    val iter = this.iterator
    while !qualify && iter.hasNext do
      val v = iter.next
      qualify = pred v

    qualify

  //[ Count elements satisfying `pred`. //]
  def count(pred: T => Bool): Int =
    var n = 0
    val iter = this.iterator
    while iter.hasNext do
      if pred(iter.next) then
        n = n + 1
    end
    n

  //[ True if every element satisfies `pred`. //]
  def forall(pred: T => Bool): Bool =
    var qualify = true

    val iter = this.iterator
    while qualify && iter.hasNext do
      val v = iter.next
      qualify = pred v

    qualify

  //[ True if `value` appears in the list. //]
  def contains(value: T)(auto eq: Eq[T] with [[T].==]): Bool =
    exists(x => eq.equal(x, value))

  //[ Return the first element satisfying `pred`, or `None`. //]
  def find(pred: T => Bool): Option[T] =
    val iter = this.iterator
    var res: Option[T] = None
    while res.isEmpty && iter.hasNext do
      val v = iter.next
      if pred v then
        res = Some(v)
    end
    res

  //[ Return a new list with elements in reverse order. //]
  def reverse: List[T] =
    val out = Array.create[T](_size)
    var i = 0
    while i < _size do
      out[i] = arr[start + _size - 1 - i]
      i = i + 1
    end
    wrap(out, _size)

  //[ Split into two lists: elements satisfying `pred` and those that don't. //]
  def partition(pred: T => Bool): List[T] ~ List[T] =
    val accepted = List.builder[T]()
    val rejected = List.builder[T]()
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next

      if pred v then
        accepted += v
      else
        rejected += v
    end
    accepted.result ~ rejected.result

  //[ Pair up elements from two lists; stops at the shorter one. //]
  def zip[S](other: List[S]): List[T ~ S] =
    val n = if _size < other.size then _size else other.size
    val out = new ListBuilder[T ~ S](n)
    val left = this.iterator
    val right = other.iterator
    while left.hasNext && right.hasNext do
      out += (left.next ~ right.next)
    end
    out.result

  //[ Pair each element with its 0-based index. //]
  def zipWithIndex: List[T ~ Int] =
    val out = new ListBuilder[T ~ Int](_size)
    var i = 0
    val iter = this.iterator
    while iter.hasNext do
      out += (iter.next ~ i)
      i = i + 1
    end
    out.result

  //[ Insert `sep` between every pair of adjacent elements. //]
  def intersperse(sep: T): List[T] =
    if _size == 0 then []
    else
      // The list is not empty, so the first element goes in before the loop
      // and every element after it brings a separator along.
      val out = new ListBuilder[T](_size * 2 - 1)
      val iter = this.iterator
      out += iter.next
      while iter.hasNext do
        out += sep
        out += iter.next
      end
      out.result

  //[ Group elements by key, returning a map from key to list of elements. //]
  def groupBy[K](f: T => K)(auto ord: Ord[K] with [[K].compareTo]) : Map[K, List[T]] =
    auto keyOrd: Ord[K] = ord
    var groups: Map[K, List[T]] = Map.empty[K, List[T]]
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next
      val key = f(v)
      val bucket = groups.getOrElse(key, [])
      groups = groups.update(key, bucket + v)
    end
    groups

  //[ Return a sorted copy of this list. //]
  def sort(auto ord: Ord[T] with [[T].compareTo]): List[T] =
    if _size <= 1 then this
    else Sorting.sortList(this)

  //[ Return a sorted copy, comparing elements by the key produced by `f`. //]
  def sortBy[S](f: T => S)
      (auto ord: Ord[S] with [[S].compareTo])
  : List[T] =
    auto itemCompare: Ord[T] = (a, b) => ord.compare(f(a), f(b))
    this.sort

  //[ Return a copy with duplicate elements removed (first occurrence kept).
    !
    ! O(n). Hashing is what keeps it linear: comparing each element against the
    ! ones already kept would be quadratic.
    !
    ! The elements need a `hashCode` that agrees with their `==`. A type that
    ! defines one without the other, or that you cannot change, needs no edit:
    ! the instance may come from the call site instead.
    !
    !     class Item(id: Int, label: String)
    !       def ==(that: Item): Bool = this.id == that.id
    !
    !     auto itemHash: Hash[Item] = item => item.id
    !     items.distinct
  //]
  def distinct(auto eq: Eq[T] with [[T].==], hash: Hash[T] with [[T].hashCode]): List[T] =
    val seen = mutable.Set.empty[T]
    val out = new ListBuilder[T](_size)
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next

      // `add` already looks the element up, so the size tells us whether it
      // was new without paying for a second lookup.
      val before = seen.size
      seen.add v

      if seen.size != before then
        out += v
    end
    out.result

  //[ Return the minimum element, or `None` if the list is empty. //]
  def minOpt(auto ord: Ord[T] with [[T].compareTo]): Option[T] =
    val iter = this.iterator
    if !iter.hasNext then
      None
    else
      var best = iter.next
      while iter.hasNext do
        val v = iter.next
        if ord.compare(v, best) < 0 then
          best = v
      end
      Some(best)

  //[ Return the maximum element, or `None` if the list is empty. //]
  def maxOpt(auto ord: Ord[T] with [[T].compareTo]): Option[T] =
    val iter = this.iterator
    if !iter.hasNext then
      None
    else
      var best = iter.next
      while iter.hasNext do
        val v = iter.next
        if ord.compare(v, best) > 0 then
          best = v
      end
      Some(best)

  //[ Return a string representation, e.g. `[1, 2, 3]`. Shows at most 100 elements. //]
  def toString(auto elementShow: Show[T] with [[T].toString]): String =
    var res = "["
    var count = 0
    val iter = this.iterator
    while count < 100 && iter.hasNext do
      val text = elementShow.show iter.next()
      if count == 0 then
        res = res + text
      else
        res = res + ", " + text
      count = count + 1
    end
    if count == 100 then res = res + ", ..."
    res = res + "]"
    res
end // List

private[jo] section ListImpl
  def errorIndex(i: Int): Bottom = abort ("invalid index for list " + i)

  //[ Who may write the free slots at the end of an array that lists share.
    !
    ! Lists share one array, so that appending to a list does not copy it: the
    ! new element goes into the first free slot past the end, and the new list
    ! covers one more slot of the same array. Older lists never look past their
    ! own end, so they do not see it.
    !
    ! That only works for one list per slot. Of `l + a` and `l + b`, the first
    ! takes the slot and the second must copy. A claim records how far the
    ! array has been taken, and a list may extend in place only if it ends
    ! exactly there.
    !
    ! Each runtime defines the claim. Where threads can reach Jo values
    ! through the FFI, two of them could take the same slot at once, so there
    ! the claim must also keep them apart.
  //]
  type Claim

  //[ A claim for a new array whose first `used` slots are taken. //]
  defer def newClaim(used: Int): Claim receives none

  //[ Take the `count` slots from `stop` on for the caller, if `stop` is still
    ! where the taken slots end and the caller may write past it.
    !
    ! After `true`, the caller is the only one that ever writes those slots.
    ! The caller checks that the array is large enough.
  //]
  defer def tryExtend(claim: Claim, stop: Int, count: Int): Bool receives none

  //[ A list of the first `size` elements of `arr`, which nothing else holds. //]
  def wrap[T](arr: Array[T], size: Int): List[T] receives none =
    new List(arr, 0, size, newClaim(size))

  //[ The capacity of a new array for `needed` elements, when a list of `size`
    ! elements outgrows its own: doubling keeps repeated appends O(1) amortized.
  //]
  def grownCapacity(needed: Int, size: Int): Int receives none =
    val doubled = if size * 2 > 8 then size * 2 else 8
    if needed > doubled then needed else doubled

  //[ Build a list of `n` elements by applying `f` to each index. //]
  def fromGenerator[T](n: Int, f: Int => T): List[T] =
    val size = if n > 0 then n else 0
    val values = Array.create[T](size)
    var i = 0
    while i < size do
      values[i] = f i
      i = i + 1
    end
    wrap(values, size)

  //[ Walks the elements `arr[from]` to `arr[until - 1]`. //]
  class ListIterator[T]
    private val arr: Array[T]
    private var i: Int
    private val until: Int

    def ListIterator(arr: Array[T], from: Int, until: Int) =
      this.arr = arr
      this.i = from
      this.until = until

    def hasNext: Bool = i < until

    def next: T =
      // The array may go on past `until`, with elements of other lists.
      if i >= until then errorIndex i
      val item = arr[i]
      i = i + 1
      item

    view Iterator[T]
  end
end // ListImpl
