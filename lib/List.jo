namespace jo

import jo.ListImpl.*


//[ Create a list from variadic arguments.
  !
  ! Example: `List(1, 2, 3)` produces `[1, 2, 3]`
//]
def List[T](elems: ..T): List[T] = elems

//[ Pattern match on list
  !
  ! This pattern is useful when the scrutinee is a union type with List as a
  ! component.
//]
pattern List[T](elems: List[T]): List[T] = case elems

//[ Ways to build a `List` other than the `[...]` literal. //]
section List
  //[ An empty list. //]
  def empty[T]: List[T] =
    val arr = Array.create[T](0)
    new List(ListImpl.Leaf(arr), 0, 0)

  //[ Start building a list one element at a time.
    !
    ! See `ListBuilder` for when to prefer this over `+`, `fill` or `tabulate`.
    !
    ! `capacity` matters only when the final length is already known to be under
    ! 32, where it saves the builder a copy; the typer passes it when lowering a
    ! list literal. For anything longer the default is what you want.
  //]
  def builder[T](capacity: Int = 32): ListBuilder[T] =
    new ListBuilder(capacity)


  //[ Create a list of `n` copies of `value`. //]
  def fill[T](n: Int, value: T): List[T] =
    ListImpl.fromGenerator(n, i => value)

  //[ Create a list of `n` elements by applying `f` to each index `0..n-1`. //]
  def tabulate[T](n: Int, f: Int => T): List[T] =
    ListImpl.fromGenerator(n, f)
end

//[ An immutable indexed sequence backed by a 32-way trie.
  !
  ! All operations are O(log₃₂ n) ≈ effectively O(1):
  !   - `get(i)`, `updated(i, v)`: O(log₃₂ n)
  !   - `+` (append one element): O(log₃₂ n) amortized
  !   - `++` (concatenate): O(min(n + m, m log₃₂ n)) where m = size of argument
  !
  ! Build a list with `[]` literal or by appending with `+`. `fill`, `tabulate`
  ! and `map` build the trie bottom up in O(n) instead, and `tabulate` is the
  ! way to turn an `Array` into a `List` in one pass.
  ! Use `for v in list` or `iterator` for O(n) traversal.
//]
class List[T]
  private val root: ListImpl.Node[T]
  private val _size: Int
  private val _depth: Int

  private[jo] def List(root: ListImpl.Node[T], size: Int, depth: Int) =
    this.root = root
    this._size = size
    this._depth = depth

  //[ Number of elements. //]
  def size: Int receives none = _size

  //[ Number of elements (alias for `size`). //]
  def length: Int receives none = _size

  //[ True if the list has no elements. //]
  def isEmpty: Bool = _size == 0

  //[ Returns an iterator over the elements in order. //]
  def iterator: Iterator[T] = new ListImpl.ListIterator(this)

  // An iterator positioned at `start`. The iterator loads its leaf on the
  // first `next`, since its `limit` starts at 0, so moving the cursor before
  // then is all it takes.
  private def iteratorFrom(start: Int): ListImpl.ListIterator[T] =
    val iter = new ListImpl.ListIterator(this)
    iter.i = start
    iter

  // Copy all elements into `arr`, starting at index `start`.
  private def copyInto(arr: Array[T], start: Int): Unit =
    var i = start
    val iter = this.iterator
    while iter.hasNext do
      arr[i] = iter.next
      i = i + 1

  //[ Return the element at index `i` (0-based). Aborts if out of bounds. //]
  def get(i: Int): T receives none =
    if i < 0 || i >= _size then errorIndex i
    lookup(root, i, _depth)

  // The leaf array holding index `i`. Used by `ListIterator` to walk the trie
  // one leaf at a time instead of once per element.
  private[jo] def leafAt(i: Int): Array[T] receives none =
    ListImpl.leafAt(root, i, _depth)

  //[ Return a new list with the element at index `i` replaced by `value`. Aborts if out of bounds. //]
  def updated(i: Int, value: T): List[T] =
    if i < 0 || i >= _size then errorIndex i
    new List(updateAt(root, i, _depth, value), _size, _depth)

  //[ Append one element to the end. //]
  def +(v: T): List[T] =
    // The trie at depth d has capacity 32^(d+1). Overflow when:
    //   _size >> (5 * (_depth + 1)) > 0
    if (_size >> (5 * (_depth + 1))) > 0 then
      val newBranch = newPath(_depth, v)
      val newChildren = Array.create[Node[T]](2)
      newChildren[0] = root
      newChildren[1] = newBranch
      new List(Internal(newChildren), _size + 1, _depth + 1)
    else
      match tryInsert(root, _size, _depth, v)
      case Some newRoot => new List(newRoot, _size + 1, _depth)
      case None => abort ("List: unexpected full trie")

  //[ Prepend one element at the front. O(n). //]
  def prepend(v: T): List[T] =
    List.builder[T](_size + 1).add(v).addAll(this.iterator).result

  //[ Concatenate two lists. O(min(n + m, m log₃₂ n)) for n = `size`, m = `l.size`. //]
  def ++(l: List[T]): List[T] =
    // Appending element by element costs O(32) per element of `l`, so it only
    // beats rebuilding the whole trie while `l` is much shorter than `this`.
    if l.size == 0 then this
    else if _size > l.size * 32 then
      var result = this
      val iter = l.iterator
      while iter.hasNext do
        result = result + iter.next
      result
    else
      List.builder[T](_size + l.size).addAll(this.iterator).addAll(l.iterator).result

  //[ Return a sublist starting at index `from` with at most `len` elements. //]
  def slice(from: Int, len: Int): List[T] receives none =
    if from >= _size || len <= 0 then []
    else
      val to = if _size - from > len then from + len else _size
      val n = to - from
      // Walking from `from` costs one trie descent per leaf, where `get` per
      // element would cost one per element.
      val iter = this.iteratorFrom(from)
      val out = List.builder[T](n)
      var i = 0
      while i < n do
        val _ = out.add iter.next
        i = i + 1
      end
      out.result

  //[ Return the first `n` elements. //]
  def take(n: Int): List[T] receives none =
    if n <= 0 then []
    else if n >= _size then this
    else this.slice(0, n)

  //[ Drop the first `n` elements and return the rest. //]
  def drop(n: Int): List[T] receives none =
    if n <= 0 then this
    else if n >= _size then []
    else this.slice(n, _size - n)

  //[ Return elements satisfying `pred`. //]
  def select(pred: T => Bool): List[T] =
    val kept = List.builder[T]()

    for v in this if pred v do
      val _ = kept.add v

    kept.result

  //[ Return elements not satisfying `pred`. //]
  def exclude(pred: T => Bool): List[T] =
    val kept = List.builder[T]()

    for v in this if !(pred v) do
      val _ = kept.add v

    kept.result

  //[ Apply `f` to each element and return the resulting list. //]
  def map[S](f: T => S): List[S] =
    val out = List.builder[S](_size)
    val iter = this.iterator
    while iter.hasNext do
      val _ = out.add(f(iter.next))
    end
    out.result

  //[ Reduce the list to a single value using a left fold. //]
  def fold[S](zero: S, f: (S, T) => S): S =
    var acc = zero

    for v in this do
      acc = f acc v

    acc

  //[ Join elements into a string with `separator` between each pair. //]
  def join(separator: String)(auto elementShow: Show[T] with [[T].toString]): String =
    var res = ""
    var first = true
    val iter = this.iterator
    while iter.hasNext do
      val text = elementShow.show iter.next()
      if first then
        res = text
        first = false
      else
        res = res + separator + text
    end
    res

  //[ True if at least one element satisfies `pred`. //]
  def exists(pred: T => Bool): Bool =
    var qualify = false

    val iter = this.iterator
    while !qualify && iter.hasNext do
      val v = iter.next
      qualify = pred v

    qualify

  //[ Count elements satisfying `pred`. //]
  def count(pred: T => Bool): Int =
    var n = 0
    val iter = this.iterator
    while iter.hasNext do
      if pred(iter.next) then
        n = n + 1
    end
    n

  //[ True if every element satisfies `pred`. //]
  def forall(pred: T => Bool): Bool =
    var qualify = true

    val iter = this.iterator
    while qualify && iter.hasNext do
      val v = iter.next
      qualify = pred v

    qualify

  //[ True if `value` appears in the list. //]
  def contains(value: T)(auto eq: Eq[T] with [[T].==]): Bool =
    exists(x => eq.equal(x, value))

  //[ Return the first element satisfying `pred`, or `None`. //]
  def find(pred: T => Bool): Option[T] =
    val iter = this.iterator
    var res: Option[T] = None
    while res.isEmpty && iter.hasNext do
      val v = iter.next
      if pred v then
        res = Some(v)
    end
    res

  //[ Return a new list with elements in reverse order. //]
  def reverse: List[T] =
    // Walked leaf by leaf from the end, so the descent through the trie costs
    // one walk per 32 elements, as a forward traversal does.
    val out = List.builder[T](_size)
    var i = _size - 1
    while i >= 0 do
      val leaf = this.leafAt(i)
      var j = i & 31
      while j >= 0 do
        val _ = out.add leaf[j]
        j = j - 1
      end
      i = i - (i & 31) - 1
    end
    out.result

  //[ Split into two lists: elements satisfying `pred` and those that don't. //]
  def partition(pred: T => Bool): List[T] ~ List[T] =
    val accepted = List.builder[T]()
    val rejected = List.builder[T]()
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next

      if pred v then
        val _ = accepted.add v
      else
        val _ = rejected.add v
    end
    accepted.result ~ rejected.result

  //[ Pair up elements from two lists; stops at the shorter one. //]
  def zip[S](other: List[S]): List[T ~ S] =
    val n = if _size < other.size then _size else other.size
    val out = List.builder[T ~ S](n)
    val left = this.iterator
    val right = other.iterator
    while left.hasNext && right.hasNext do
      val _ = out.add(left.next ~ right.next)
    end
    out.result

  //[ Pair each element with its 0-based index. //]
  def zipWithIndex: List[T ~ Int] =
    val out = List.builder[T ~ Int](_size)
    var i = 0
    val iter = this.iterator
    while iter.hasNext do
      val _ = out.add(iter.next ~ i)
      i = i + 1
    end
    out.result

  //[ Insert `sep` between every pair of adjacent elements. //]
  def intersperse(sep: T): List[T] =
    if _size == 0 then []
    else
      // The list is not empty, so the first element goes in before the loop
      // and every element after it brings a separator along.
      val out = List.builder[T](_size * 2 - 1)
      val iter = this.iterator
      val _ = out.add iter.next
      while iter.hasNext do
        val _ = out.add sep
        val _ = out.add iter.next
      end
      out.result

  //[ Group elements by key, returning a map from key to list of elements. //]
  def groupBy[K](f: T => K)(auto ord: Ord[K] with [[K].compareTo]) : Map[K, List[T]] =
    auto keyOrd: Ord[K] = ord
    var groups: Map[K, List[T]] = Map.empty[K, List[T]]
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next
      val key = f(v)
      val bucket = groups.getOrElse(key, [])
      groups = groups.update(key, bucket + v)
    end
    groups

  //[ Return a sorted copy of this list. //]
  def sort(auto ord: Ord[T] with [[T].compareTo]): List[T] =
    if _size <= 1 then this
    else
      val arr = Array.create[T](_size)
      copyInto(arr, 0)
      Sorting.sortArray(arr, 0, _size - 1, ord)
      ListImpl.fromOwnedArray(arr)

  //[ Return a sorted copy, comparing elements by the key produced by `f`. //]
  def sortBy[S](f: T => S)
      (auto ord: Ord[S] with [[S].compareTo])
  : List[T] =
    auto itemCompare: Ord[T] = (a, b) => ord.compare(f(a), f(b))
    this.sort

  //[ Return a copy with duplicate elements removed (first occurrence kept). //]
  def distinct(auto eq: Eq[T] with [[T].==]): List[T] =
    val arr = Array.create[T](_size)
    var n = 0
    val iter = this.iterator
    while iter.hasNext do
      val v = iter.next
      var seen = false
      var i = 0

      while !seen && i < n do
        seen = eq.equal(arr[i], v)
        i = i + 1
      end

      if !seen then
        arr[n] = v
        n = n + 1
    end
    ListImpl.fromArray(arr, n)

  //[ Return the minimum element, or `None` if the list is empty. //]
  def minOpt(auto ord: Ord[T] with [[T].compareTo]): Option[T] =
    val iter = this.iterator
    if !iter.hasNext then
      None
    else
      var best = iter.next
      while iter.hasNext do
        val v = iter.next
        if ord.compare(v, best) < 0 then
          best = v
      end
      Some(best)

  //[ Return the maximum element, or `None` if the list is empty. //]
  def maxOpt(auto ord: Ord[T] with [[T].compareTo]): Option[T] =
    val iter = this.iterator
    if !iter.hasNext then
      None
    else
      var best = iter.next
      while iter.hasNext do
        val v = iter.next
        if ord.compare(v, best) > 0 then
          best = v
      end
      Some(best)

  //[ Return a string representation, e.g. `[1, 2, 3]`. Shows at most 100 elements. //]
  def toString(auto elementShow: Show[T] with [[T].toString]): String =
    var res = "["
    var count = 0
    val iter = this.iterator
    while count < 100 && iter.hasNext do
      val text = elementShow.show iter.next()
      if count == 0 then
        res = res + text
      else
        res = res + ", " + text
      count = count + 1
    end
    if count == 100 then res = res + ", ..."
    res = res + "]"
    res
end // List

private[jo] section ListImpl
  union Node[T] =
      Internal(children: Array[Node[T]])
    | Leaf(values: Array[T])

  def errorIndex(i: Int): Bottom = abort ("invalid index for list " + i)

  //[ Build a list from the first `n` elements of `arr`, bottom up, in O(n).
    !
    ! The result has exactly the shape `n` successive `+` operations would
    ! produce, but allocates one node per 32 elements instead of one node and
    ! one array copy per element.
  //]
  def fromArray[T](arr: Array[T], n: Int): List[T] =
    if n <= 32 then
      // A single leaf: no level array and no grouping pass are needed.
      val size = if n > 0 then n else 0
      val values = Array.create[T](size)
      var i = 0
      while i < size do
        values[i] = arr[i]
        i = i + 1
      end
      new List(Leaf(values), size, 0)

    else
      // The leaf level: full 32-element leaves, with a partial one at the end.
      val leafCount = (n + 31) >> 5
      val level = Array.create[Node[T]](leafCount)
      var i = 0
      while i < leafCount do
        val from = i << 5
        val width = if n - from > 32 then 32 else n - from
        val values = Array.create[T](width)
        var j = 0
        while j < width do
          values[j] = arr[from + j]
          j = j + 1
        end
        level[i] = Leaf(values)
        i = i + 1
      end

      fromLeaves(level, leafCount - 1, level[leafCount - 1], n)

  //[ Assemble `leafCount` leaves followed by `tail`, holding `n` elements in
    ! all, into a list.
    !
    ! The last leaf is passed on its own because a builder's leaf in progress
    ! does not live in its spine array: without a tail parameter the builder
    ! would have to copy the whole spine to make room for it. `leaves` may be
    ! longer than `leafCount`; only the first `leafCount` entries are read.
  //]
  def fromLeaves[T](leaves: Array[Node[T]], leafCount: Int, tail: Node[T], n: Int): List[T] =
    // Group each level into parents of at most 32 children until one is left.
    // `last` is the node holding the tail at the current level: it sits one
    // past `level` on the first pass and inside it on every pass after.
    var level = leaves
    var count = leafCount + 1
    var last = tail
    var depth = 0

    while count > 1 do
      val parentCount = (count + 31) >> 5
      val parents = Array.create[Node[T]](parentCount)
      var p = 0
      while p < parentCount do
        val from = p << 5
        val width = if count - from > 32 then 32 else count - from
        val children = Array.create[Node[T]](width)
        var j = 0
        while j < width do
          children[j] = if from + j == count - 1 then last else level[from + j]
          j = j + 1
        end
        parents[p] = Internal(children)
        p = p + 1
      end

      level = parents
      count = parentCount
      last = parents[parentCount - 1]
      depth = depth + 1
    end

    new List(last, n, depth)

  //[ Build a list of `n` elements by filling each leaf straight from `f`.
    !
    ! Unlike `fromArray` no intermediate array is materialised: the elements go
    ! directly into the leaves that make up the trie.
  //]
  def fromGenerator[T](n: Int, f: Int => T): List[T] =
    if n <= 32 then
      // A single leaf: no spine array and no grouping pass are needed.
      val size = if n > 0 then n else 0
      val values = Array.create[T](size)
      var i = 0
      while i < size do
        values[i] = f i
        i = i + 1
      end
      new List(Leaf(values), size, 0)

    else
      val leafCount = (n + 31) >> 5
      val leaves = Array.create[Node[T]](leafCount)
      var i = 0
      while i < leafCount do
        val from = i << 5
        val width = if n - from > 32 then 32 else n - from
        val values = Array.create[T](width)
        var j = 0
        while j < width do
          values[j] = f (from + j)
          j = j + 1
        end
        leaves[i] = Leaf(values)
        i = i + 1
      end

      fromLeaves(leaves, leafCount - 1, leaves[leafCount - 1], n)

  //[ Like `fromArray`, but the array becomes the list's own storage when it
    ! fits in a single leaf, so no copy is made. The caller must not touch `arr`
    ! afterwards. Above 32 elements the array has to be split across leaves, so
    ! the copy is unavoidable and this falls back to `fromArray`.
  //]
  def fromOwnedArray[T](arr: Array[T]): List[T] =
    val n = arr.size

    if n <= 32 then new List(Leaf(arr), n, 0)
    else fromArray(arr, n)

  //[ The leaf array holding index `i`. //]
  def leafAt[T](node: Node[T], i: Int, depth: Int): Array[T] =
    match node
    case Leaf values =>
      values

    case Internal children =>
      val idx = (i >> (5 * depth)) & 31
      leafAt(children[idx], i, depth - 1)

  //[ Walks the trie one leaf at a time.
    !
    ! Fetching the leaf costs one root-to-leaf walk per 32 elements rather than
    ! one per element, so a full traversal is O(n) instead of O(n log₃₂ n).
  //]
  class ListIterator[T](l: List[T])
    val count: Int = l.size
    var i: Int = 0

    // The leaf holding index `i`, and the index just past the elements it
    // covers. `limit` starts at 0 so the first `next` loads a leaf.
    var leaf: Array[T] = Array.create[T](0)
    var limit: Int = 0

    def hasNext: Bool = i < count

    def next: T =
      if i >= limit then
        // Only reached once per leaf, so bounds-checking here is free.
        if i >= count then errorIndex i

        leaf = l.leafAt(i)
        limit = i - (i & 31) + leaf.size

      val item = leaf[i & 31]
      i = i + 1
      item

    view Iterator[T]
  end

  def lookup[T](node: Node[T], i: Int, depth: Int): T =
    match node
    case Leaf values =>
      values[i & 31]
    case Internal children =>
      val idx = (i >> (5 * depth)) & 31
      lookup(children[idx], i, depth - 1)

  def copyAppendT[T](arr: Array[T], value: T): Array[T] =
    val n = arr.size
    val res = Array.create[T](n + 1)
    var i = 0
    while i < n do
      res[i] = arr[i]
      i = i + 1
    res[n] = value
    res

  def copyAppendNode[T](arr: Array[Node[T]], value: Node[T]): Array[Node[T]] =
    val n = arr.size
    val res = Array.create[Node[T]](n + 1)
    var i = 0
    while i < n do
      res[i] = arr[i]
      i = i + 1
    res[n] = value
    res

  def copySetT[T](arr: Array[T], idx: Int, value: T): Array[T] =
    val n = arr.size
    val res = Array.create[T](n)
    var i = 0
    while i < n do
      res[i] = arr[i]
      i = i + 1
    res[idx] = value
    res

  def copySetNode[T](arr: Array[Node[T]], idx: Int, value: Node[T]): Array[Node[T]] =
    val n = arr.size
    val res = Array.create[Node[T]](n)
    var i = 0
    while i < n do
      res[i] = arr[i]
      i = i + 1
    res[idx] = value
    res

  def newPath[T](depth: Int, value: T): Node[T] =
    if depth == 0 then
      val arr = Array.create[T](1)
      arr[0] = value
      Leaf(arr)
    else
      val child = newPath(depth - 1, value)
      val arr = Array.create[Node[T]](1)
      arr[0] = child
      Internal(arr)

  def updateAt[T](node: Node[T], i: Int, depth: Int, value: T): Node[T] =
    match node
    case Leaf values =>
      Leaf(copySetT(values, i & 31, value))
    case Internal children =>
      val idx = (i >> (5 * depth)) & 31
      val newChild = updateAt(children[idx], i, depth - 1, value)
      Internal(copySetNode(children, idx, newChild))

  // Precondition: root-level overflow check has already been done.
  def tryInsert[T](node: Node[T], newIdx: Int, depth: Int, value: T): Option[Node[T]] =
    match node
    case Leaf values =>
      if values.size < 32 then
        Some(Leaf(copyAppendT(values, value)))
      else
        None

    case Internal children =>
      val branchIdx = (newIdx >> (5 * depth)) & 31
      if branchIdx < children.size then
        match tryInsert(children[branchIdx], newIdx, depth - 1, value)
        case Some newChild =>
          Some(Internal(copySetNode(children, branchIdx, newChild)))
        case None =>
          if children.size < 32 then
            val sibling = newPath(depth - 1, value)
            Some(Internal(copyAppendNode(children, sibling)))
          else
            None
      else
        val newBranch = newPath(depth - 1, value)
        Some(Internal(copyAppendNode(children, newBranch)))

end // ListImpl
