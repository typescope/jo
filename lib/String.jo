namespace jo

import jo.regex.*
import jo.compile.intrinsic

//[ Backend string primitives.
  !
  ! All indices and lengths use Unicode code point units.
//]
@intrinsic
class String
  private def String() = abort "Cannot create new String instance"

  //[ Number of Unicode code points in the string.    //]
  @intrinsic
  def size: Int = ...

  //[ Code point at index `i`.    //]
  @intrinsic
  def get(i: Int): Char = ...

  //[ Concatenate two strings.    //]
  @intrinsic
  def +(other: StringLike): String = ...

  //[ String equality.    //]
  @intrinsic
  def ==(other: String): Bool = ...

  //[ Substring from `from` with `len` code points.    //]
  @intrinsic
  def substring(from: Int, len: Int): String = ...

  //[ First occurrence of `other` at/after `from`, or -1.    //]
  @intrinsic
  def indexOf(other: String, from: Int = 0): Int = ...

  //[ Unicode lowercase mapping.    //]
  @intrinsic
  def toLower: String = ...

  //[ Unicode uppercase mapping.    //]
  @intrinsic
  def toUpper: String = ...

  //[ Iterator over Unicode code points.    //]
  @intrinsic
  def iterator: Iterator[Char] = ...

  //[ Inequality.    //]
  def !=(other: String): Bool = !(this == other)

  //[ The number of characters (alias for `size`). //]
  def length: Int = this.size

  //[ True when string length is zero.    //]
  def isEmpty: Bool = this.size == 0

  //[ Alias of substring.    //]
  def slice(from: Int, len: Int): String = this.substring from len

  //[ Repeat the string `n` times. Returns "" when `n <= 0`.    //]
  def *(n: Int): String =
    if n <= 0 then ""
    else
      var k = n
      var chunk = this
      var result = ""
      while k > 0 do
        if k % 2 == 1 then
          result = result + chunk
        end
        k = k / 2
        if k > 0 then
          chunk = chunk + chunk
        end
      end
      result

  //[ Parse signed decimal integer. Aborts on invalid input.    //]
  def toInt: Int =
    match Int.parse(this)
    case Some(n) => n
    case None => abort("Invalid Int: " + this)

  //[ Parse signed decimal integer. Returns None on invalid input.    //]
  def toIntOpt: Option[Int] =
    Int.parse(this)

  //[ Parse decimal float with optional sign and exponent. Aborts on invalid input.    //]
  def toFloat: Float =
    match Float.parse(this)
    case Some(x) => x
    case None => abort("Invalid Float: " + this)

  //[ Parse decimal float with optional sign and exponent. Returns None on invalid input.    //]
  def toFloatOpt: Option[Float] =
    Float.parse(this)

  //[ Lexicographic comparison by Unicode code points.
    !
    ! Returns a negative value if this string precedes `other`, zero if they
    ! are equal, and a positive value if this string follows `other`.
    !
    ! If one string is a prefix of the other, the shorter string comes first.
    !
    ! Only the sign is guaranteed; do not rely on the magnitude of the result.
  //]
  def compareTo(other: String): Int =
    StringOps.compareTo(this, other)

  //[ A hash of the characters, computed as `hash * 31 + codePoint`.
    !
    ! Used to synthesize `Hash[String]`. Equal strings hash equally; the value
    ! is not stable across releases and must not be persisted.
  //]
  def hashCode: Int =
    var hash = 0
    var i = 0
    while i < this.size do
      hash = hash * 31 + this[i].toInt
      i = i + 1
    end
    hash

  //[ Last occurrence of `other`, or -1.    //]
  def lastIndexOf(other: String): Int =
    val sLen = this.size
    val oLen = other.size
    if oLen == 0 then sLen
    else
      var found = 0 - 1
      var nextFrom = 0
      var i = this.indexOf(other)
      while i >= 0 do
        found = i
        nextFrom = i + 1
        i = this.indexOf(other, nextFrom)
      end
      found

  //[ True if `other` appears in this string.    //]
  def contains(other: String): Bool = this.indexOf(other) >= 0

  //[ True if string starts with `prefix`. Stops at the first unequal code point. //]
  def startsWith(prefix: String): Bool =
    val source = this.iterator
    val start = prefix.iterator
    var matches = true

    while matches && start.hasNext do
      matches = source.hasNext && source.next == start.next
    end

    matches

  //[ True if string ends with `suffix`.    //]
  def endsWith(suffix: String): Bool =
    val sLen = this.size
    val sfLen = suffix.size
    if sfLen > sLen then false
    else
      val start = sLen - sfLen
      this.indexOf(suffix, start) == start

  //[ Remove leading ASCII whitespace: space, tab, newline, carriage return, vertical tab, and form feed. //]
  def trimStart: String = StringOps.trim(this, leading = true, trailing = false)

  //[ Remove trailing ASCII whitespace: space, tab, newline, carriage return, vertical tab, and form feed. //]
  def trimEnd: String = StringOps.trim(this, leading = false, trailing = true)

  //[ Remove leading and trailing ASCII whitespace: space, tab, newline, carriage return, vertical tab, and form feed. //]
  def trim: String = StringOps.trim(this, leading = true, trailing = true)

  //[ Replace all non-overlapping occurrences of `target`.    //]
  def replace(target: String, replacement: String): String =
    val tLen = target.size
    if tLen == 0 then this
    else
      var result = ""
      val sLen = this.size
      var start = 0
      var i = this.indexOf(target)
      while i >= 0 do
        result = result + this.substring(start, i - start) + replacement
        start = i + tLen
        i = this.indexOf(target, start)
      end
      result + this.substring(start, sLen - start)

  //[ Replace the first regex match using a callback.    //]
  def replaceFirst(pat: Regex, replacement: Match => String): String =
    pat.replaceFirst(this, replacement)

  //[ Replace all regex matches using a callback.    //]
  def replaceAll(pat: Regex, replacement: Match => String): String =
    pat.replaceAll(this, replacement)

  //[ True when some regex match exists in the string.    //]
  def exists(pat: Regex): Bool =
    match pat.matchFirst(this)
    case Some(_) => true
    case None => false

  //[ First regex match in this string, or `None`.    //]
  def matchFirst(pat: Regex): Option[Match] =
    pat.matchFirst(this)

  //[ All non-overlapping regex matches in this string.    //]
  def matchAll(pat: Regex): List[Match] =
    pat.matchAll(this)

  //[ Split using a regex separator.    //]
  def splitBy(pat: Regex): List[String] =
    pat.split(this)

  //[ Split by separator; empty separator returns a singleton list.    //]
  def split(separator: String): List[String] =
    val sepLen = separator.size
    if sepLen == 0 then
      List.empty[String] + this
    else
      val sLen = this.size
      var parts = List.empty[String]
      var start = 0
      var i = this.indexOf(separator)
      while i >= 0 do
        parts = parts + this.substring(start, i - start)
        start = i + sepLen
        i = this.indexOf(separator, start)
      end
      parts + this.substring(start, sLen - start)

  //[ Lazy iterator over lines using '\n' and '\r\n' separators.
    ! Empty input has no lines; a final separator adds no extra empty line.
  //]
  def lineIterator: Iterator[String] = new String.LineIterator(this)

  //[ Split into lines using '\n' and '\r\n' separators.
    ! Empty input has no lines; a final separator adds no extra empty line.
  //]
  def lines: List[String] =
    this.lineIterator.toList
end

//[ Anything printable: a `String`, or a value with a `toString` member
  !
  ! Used by `print` and `println` so a call site does not have to convert
  ! first: `println 42` and `println list` both work.
//]
type StringLike = String :- [.toString]

private section String
  class LineIterator(s: String)
    val chars: Iterator[Char] = s.iterator
    var pos: Int = 0

    def hasNext: Bool = chars.hasNext

    def next: String =
      if !hasNext then abort "iterator exhausted"

      val start = pos
      var lineEnd = pos
      var previous: Char = '\n'
      var ended = false

      while chars.hasNext && !ended do
        val ch = chars.next
        pos = pos + 1

        if ch == '\n' then
          lineEnd = if previous == '\r' then pos - 2 else pos - 1
          ended = true
        else
          lineEnd = pos
          previous = ch
        end
      end

      s.substring(start, lineEnd - start)

    view Iterator[String]
  end
end

// Backend runtimes can replace these string operations.
private section StringOps
  // Use an iterator in the portable fallback: indexed access may rescan
  // UTF-8/UTF-16 prefixes and become quadratic for long whitespace runs.
  defer def trim(str: String, leading: Bool, trailing: Bool): String =
    if !leading && !trailing then return str

    if !trailing then
      val iter = str.iterator
      var start = 0

      while iter.hasNext && isWhitespace(iter.next) do
        start = start + 1
      end

      if start == 0 then return str
      return str.substring(start, str.size - start)
    end

    val n = str.size
    if n == 0 then return str

    if !isWhitespace(str.get(n - 1)) && (!leading || !isWhitespace(str.get(0))) then
      return str
    end

    val iter = str.iterator
    var i = 0
    var start = if leading then -1 else 0
    var stop = 0

    while iter.hasNext do
      val c = iter.next

      if !isWhitespace(c) then
        if start < 0 then start = i
        stop = i + 1
      end

      i = i + 1
    end

    if start < 0 then ""
    else if start == 0 && stop == i then str
    else str.substring(start, stop - start)

  //[ True for one of the six ASCII whitespace characters. //]
  private def isWhitespace(c: Char): Bool = c == ' ' || c >= '\t' && c <= '\r'

  defer def compareTo(str: String, other: String): Int =
    val left = str.iterator
    val right = other.iterator
    var result = 0
    var done = false
    while left.hasNext && right.hasNext && !done do
      val c1 = left.next.toInt
      val c2 = right.next.toInt
      if c1 != c2 then
        result = c1 - c2
        done = true
      end
    end
    if done then result
    else if left.hasNext then 1
    else if right.hasNext then -1
    else 0
end
