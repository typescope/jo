namespace jo

//[ A one-pass cursor over a sequence of values
  !
  ! Implement `hasNext` and `next`; the remaining methods are derived from
  ! them. A type with an `iterator` member can be used directly in `for`, and
  ! satisfies a `:- [.iterator]` requirement.
  !
  !     val iter = list.iterator
  !     while iter.hasNext do
  !       println iter.next
  !     end
  !
  ! An iterator is consumed as it is read and cannot be restarted. `map`,
  ! `select`, `take` and `drop` are lazy: they wrap this iterator instead of
  ! copying it, so the wrapper and the original must not both be read.
//]
interface Iterator[T]
  //[ True if a further call to `next` will produce a value. //]
  def hasNext: Bool

  //[ Return the next value and advance. Reading past the end is undefined. //]
  def next: T

  //[ Return an iterator that applies `f` to each remaining value. Lazy. //]
  def map[S](f: T => S): Iterator[S] =
    new Iterator.MapIterator(this, f)

  //[ Return an iterator over the remaining values satisfying `pred`. Lazy. //]
  def select(pred: T => Bool): Iterator[T] =
    new Iterator.SelectIterator(this, pred)

  //[ Return an iterator over at most the next `n` values. Lazy. //]
  def take(n: Int): Iterator[T] =
    new Iterator.TakeIterator(this, n)

  //[ Return an iterator that skips the next `n` values. Lazy. //]
  def drop(n: Int): Iterator[T] =
    new Iterator.DropIterator(this, n)

  //[ Reduce the remaining values with a left fold, consuming the iterator. //]
  def fold[S](zero: S, f: (S, T) => S): S =
    var acc = zero
    while this.hasNext do
      acc = f(acc, this.next)
    end
    acc

  //[ Collect the remaining values into a `List`, consuming the iterator. //]
  def toList: List[T] =
    var acc: List[T] = []
    while this.hasNext do
      acc = acc + this.next
    end
    acc
end

private section Iterator
  class MapIterator[T, S](source: Iterator[T], f: T => S)
    def hasNext: Bool = source.hasNext

    def next: S = f(source.next)

    view Iterator[S]
  end

  class SelectIterator[T](source: Iterator[T], pred: T => Bool)
    var buffered: Option[T] = None

    private def fill: Unit =
      while buffered.isEmpty && source.hasNext do
        val v = source.next
        if pred(v) then
          buffered = Some(v)
        end
      end

    def hasNext: Bool =
      fill()
      !buffered.isEmpty

    def next: T =
      fill()

      match buffered
      case Some(v) =>
        buffered = None
        v
      case None =>
        abort "iterator exhausted"

    view Iterator[T]
  end

  class TakeIterator[T](source: Iterator[T], count: Int)
    var remaining: Int = if count > 0 then count else 0

    def hasNext: Bool = remaining > 0 && source.hasNext

    def next: T =
      if !hasNext then
        abort "iterator exhausted"
      end
      remaining = remaining - 1
      source.next

    view Iterator[T]
  end

  class DropIterator[T](source: Iterator[T], count: Int)
    var dropped: Bool = false
    val target: Int = if count > 0 then count else 0

    private def ensureDropped: Unit =
      if !dropped then
        var i = 0
        while i < target && source.hasNext do
          val _ = source.next()
          i = i + 1
        end
        dropped = true
      end


    def hasNext: Bool =
      ensureDropped()
      source.hasNext

    def next: T =
      ensureDropped()
      source.next

    view Iterator[T]
  end
end
