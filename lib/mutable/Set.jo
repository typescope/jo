namespace jo.mutable

import jo.*

//[ Factory methods for `mutable.Set`. //]
section Set
  def initialCapacity: Int = 16

  //[ Create an empty set. //]
  def empty[T]
      (auto
        eq: Eq[T] with [[T].==],
        hash: Hash[T] with [[T].hashCode])
    : Set[T] =

    val buckets = Array.create[jo.List[T]](initialCapacity)
    var i = 0
    while i < initialCapacity do
      buckets[i] = jo.List.empty[T]
      i = i + 1
    end
    new Set(buckets, 0, eq, hash)
end

//[ Create a `mutable.Set` from the given elements. Duplicates are discarded. //]
def Set[T](elems: ..T)
    (auto
      eq: Eq[T] with [[T].==],
      hash: Hash[T] with [[T].hashCode])
  : Set[T] =

  val s = Set.empty[T]
  for elem in elems do
    s.add(elem)
  end
  s

//[ A mutable set backed by a hash table with separate chaining. Membership
//  test, add, and remove are O(1) on average. The table grows and rehashes
//  when the load factor exceeds 0.75. Iteration order is unspecified.
//]
class Set[T]
  val eq: Eq[T]
  val hash: Hash[T]
  var buckets: Array[jo.List[T]]
  var _size: Int

  def Set(buckets: Array[jo.List[T]], size: Int, eq: Eq[T], hash: Hash[T]) =
    this.buckets = buckets
    this._size = size
    this.eq = eq
    this.hash = hash

  //[ Number of elements. //]
  def size: Int = _size

  //[ Number of elements (alias for `size`). //]
  def length: Int = _size

  private def capacity: Int = buckets.size

  private def bucketIndexFor(x: T, cap: Int): Int =
    (hash.hashCode(x) & 0x7fffffff) % cap

  private def bucketIndex(x: T): Int =
    bucketIndexFor(x, capacity)

  private def shouldGrow(nextSize: Int): Bool =
    // Grow when load factor exceeds 0.75.
    nextSize * 4 > capacity * 3

  private def rehash(newCapacity: Int): Unit =
    val oldBuckets = buckets
    val oldCapacity = oldBuckets.size
    val newBuckets = Array.create[jo.List[T]](newCapacity)
    var i = 0
    while i < newCapacity do
      newBuckets[i] = jo.List.empty[T]
      i = i + 1
    end

    i = 0
    while i < oldCapacity do
      val bucket = oldBuckets[i]
      for x in bucket do
        val index = bucketIndexFor(x, newCapacity)
        newBuckets[index] = newBuckets[index] + x
      end
      i = i + 1
    end

    buckets = newBuckets

  //[ True if `x` is a member of the set. //]
  def contains(x: T): Bool =
    val index = bucketIndex x
    val bucket = buckets[index]
    bucket.exists(e => eq.equal(e, x))

  //[ Add `x` to the set. Does nothing if it is already present. Amortized O(1). //]
  def add(x: T): Unit =
    var index = bucketIndex x
    var oldBucket = buckets[index]

    // Check if element exists
    val existed = oldBucket.exists(e => eq.equal(x, e))

    if !existed then
      if shouldGrow(_size + 1) then
        rehash(capacity * 2)
        index = bucketIndex x
        oldBucket = buckets[index]

      // Add new element
      buckets[index] = oldBucket + x
      _size = _size + 1

  //[ Add `x` to the set (alias for `add`). //]
  def +=(x: T): Unit = add x

  //[ Remove `x` from the set. Does nothing if it is absent. //]
  def remove(x: T): Unit =
    val index = bucketIndex x
    val oldBucket = buckets[index]
    val existed = oldBucket.exists(e => eq.equal(x, e))

    if existed then
      buckets[index] = oldBucket.exclude(e => eq.equal(x, e))
      _size = _size - 1

  //[ Remove `x` from the set (alias for `remove`). //]
  def -=(x: T): Unit = remove x

  //[ Add all elements from `xs`. //]
  def addAll(xs: Iterator[T] :- [.iterator]): Unit =
    for x in xs do
      add x
    end

  //[ Add all elements from `xs` (alias for `addAll`). //]
  def ++=(xs: Iterator[T] :- [.iterator]): Unit = addAll xs

  //[ Remove all elements. //]
  def clear: Unit =
    var i = 0
    while i < capacity do
      buckets[i] = jo.List.empty[T]
      i = i + 1
    end
    _size = 0

  //[ Reduce to a single value using a left fold with `f: (S, T) => S`.
  //  Elements are visited in unspecified order.
  //]
  def fold[S](zero: S, f: (S, T) => S): S =
    var acc = zero
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      for e in bucket do
        acc = f acc e
      end
      i = i + 1
    end
    acc

  //[ True if at least one element satisfies `pred`. //]
  def exists(pred: T => Bool): Bool =
    var found = false
    var i = 0
    while i < capacity && !found do
      val bucket = buckets[i]
      found = bucket.exists pred
      i = i + 1
    end
    found

  //[ True if every element satisfies `pred`. //]
  def forall(pred: T => Bool): Bool =
    var result = true
    var i = 0
    while i < capacity && result do
      val bucket = buckets[i]
      result = bucket.forall pred
      i = i + 1
    end
    result

  //[ Return an iterator over the elements, in unspecified order. //]
  def iterator: Iterator[T] =
    this.toList.iterator

  //[ Copy all elements into a new immutable `List`, in unspecified order. //]
  def toList: jo.List[T] =
    var elements: jo.List[T] = []
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      elements = elements ++ bucket
      i = i + 1
    end
    elements

  //[ Return a string representation, e.g. `{1, 2, 3}`. Shows at most 100 elements. //]
  def toString(auto elementShow: Show[T] with [[T].toString]): String =
    // Show at most 100
    var res = "{"
    var count = 0
    val iter = this.iterator
    while count < 100 && iter.hasNext do
      val text = elementShow.show iter.next()
      if count == 0 then
        res = res + text
      else
        res = res + ", " + text
      count = count + 1
    end
    if count == 100 then res = res + ", ..."
    res = res + "}"
    res
end
