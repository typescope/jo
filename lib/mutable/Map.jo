namespace jo.mutable

//[ Factory methods for `mutable.Map`. //]
section Map
  //[ Number of slots a new map starts with, before it first grows. //]
  def initialCapacity: Int = 16

  //[ Create an empty map. //]
  def empty[K, V]
      (auto
        eq: Eq[K] with [[K].==],
        hash: Hash[K] with [[K].hashCode]
      )
    : Map[K, V] =

    val buckets = Array.create[jo.List[K ~ V]](Map.initialCapacity)
    var i = 0
    while i < Map.initialCapacity do
      buckets[i] = jo.List.empty[K ~ V]
      i = i + 1
    end
    new Map(buckets, 0, eq, hash)
end

//[ Create a `mutable.Map` from the given key-value pairs. //]
def Map[K, V](elems: ..Pair[K, V])
    (auto
      eq: Eq[K] with [[K].==],
      hash: Hash[K] with [[K].hashCode])
  : Map[K, V] =

  val m = Map.empty[K, V]
  for a ~ b in elems do
    m.add(a, b)
  end
  m

//[ A mutable hash table with separate chaining.
  !
  ! Lookup, insert, and remove are O(1) on average. The table grows and
  ! rehashes when the load factor exceeds 0.75.
  !
  ! Iteration order is unspecified.
//]
class Map[K, V]
  val eq: Eq[K]
  val hash: Hash[K]
  var buckets: Array[jo.List[K ~ V]]
  var _size: Int

  def Map(buckets: Array[jo.List[K ~ V]], size: Int, eq: Eq[K], hash: Hash[K]) =
    this.buckets = buckets
    this._size = size
    this.eq = eq
    this.hash = hash

  //[ Number of key-value pairs. //]
  def size: Int = _size

  //[ Number of key-value pairs (alias for `size`). //]
  def length: Int = _size

  private def capacity: Int = buckets.size

  private def bucketIndexFor(k: K, cap: Int): Int =
    (hash.hashCode(k) & 0x7fffffff) % cap

  private def bucketIndex(k: K): Int =
    bucketIndexFor(k, capacity)

  private def shouldGrow(nextSize: Int): Bool =
    // Grow when load factor exceeds 0.75.
    nextSize * 4 > capacity * 3

  private def rehash(newCapacity: Int): Unit =
    val oldBuckets = buckets
    val oldCapacity = oldBuckets.size
    val newBuckets = Array.create[jo.List[K ~ V]](newCapacity)
    var i = 0
    while i < newCapacity do
      newBuckets[i] = jo.List.empty[K ~ V]
      i = i + 1
    end

    i = 0
    while i < oldCapacity do
      val bucket = oldBuckets[i]
      for p in bucket do
        val index = bucketIndexFor(p.fst, newCapacity)
        newBuckets[index] = newBuckets[index] + p
      end
      i = i + 1
    end

    buckets = newBuckets

  //[ True if `k` is bound in the map. //]
  def contains(k: K): Bool =
    val index = bucketIndex k
    val bucket = buckets[index]
    bucket.exists(p => eq.equal(p.fst, k))

  //[ Return `Some(v)` if `k` is bound to `v`, `None` otherwise. //]
  def getOpt(k: K): Option[V] =
    val index = bucketIndex k
    val bucket = buckets[index]
    var result: Option[V] = None
    for p in bucket if eq.equal(p.fst, k) do
      result = Some p.snd
    end
    result

  //[ Return the value bound to `k`. Aborts if the key is absent. //]
  def get(k: K): V =
    match getOpt k
    case Some(v) => v
    case None => abort "key not found"

  //[ Return the value bound to `k`, or `default` if the key is absent. //]
  def getOrElse(k: K, default: V): V =
    match getOpt k
    case Some(v) => v
    case None => default

  //[ Bind `k` to `v` (alias for `update`). //]
  def set(k: K, v: V): Unit = update(k, v)

  //[ Bind `k` to `v`, replacing any existing binding. Amortized O(1). //]
  def update(k: K, v: V): Unit =
    var index = bucketIndex k
    var oldBucket = buckets[index]

    // Check if key exists
    val existed = oldBucket.exists(p => eq.equal(k, p.fst))

    if existed then
      // Update existing entry
      buckets[index] = oldBucket.map: p =>
        if eq.equal(p.fst, k) then k ~ v else p
    else
      if shouldGrow(_size + 1) then
        rehash(capacity * 2)
        index = bucketIndex k
        oldBucket = buckets[index]

      // Add new entry
      buckets[index] = oldBucket + (k ~ v)
      _size = _size + 1

  //[ Bind `k` to `v` (alias for `update`). //]
  def add(k: K, v: V): Unit = update k v

  //[ Add all key-value pairs from `pairs`, replacing existing bindings. //]
  def addAll(pairs: Iterator[K ~ V] :- [.iterator]): Unit =
    while pairs.hasNext do
      val p = pairs.next()
      update p.fst p.snd
    end

  //[ Add all key-value pairs from `pairs` (alias for `addAll`). //]
  def ++=(pairs: Iterator[K ~ V] :- [.iterator]): Unit = addAll pairs

  //[ Remove the binding for `k`. Does nothing if the key is absent. //]
  def remove(k: K): Unit =
    val index = bucketIndex k
    val oldBucket = buckets[index]
    val existed = oldBucket.exists(p => eq.equal(k, p.fst))

    if existed then
      buckets[index] = oldBucket.exclude(p => eq.equal(k, p.fst))
      _size = _size - 1

  //[ Remove all bindings. //]
  def clear: Unit =
    var i = 0
    while i < capacity do
      buckets[i] = jo.List.empty[K ~ V]
      i = i + 1
    end
    _size = 0

  //[ Reduce to a single value using a left fold with `f: (S, K, V) => S`.
    !
    ! Pairs are visited in unspecified order.
  //]
  def fold[S](zero: S, f: (S, K, V) => S): S =
    var acc = zero
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      for p in bucket do
        acc = f acc p.fst p.snd
      end
      i = i + 1
    end
    acc

  //[ Return all keys as an immutable `List`, in unspecified order. //]
  def keys: jo.List[K] =
    var keys: jo.List[K] = []
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      keys = keys ++ bucket.map(p => match p case k ~ v => k)
      i = i + 1
    end
    keys

  //[ Return all values as an immutable `List`, in unspecified order. //]
  def values: jo.List[V] =
    var values: jo.List[V] = []
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      values = values ++ bucket.map(p => match p case k ~ v => v)
      i = i + 1
    end
    values

  //[ Copy all key-value pairs into a new immutable `List`, in unspecified order. //]
  def toList: jo.List[K ~ V] =
    // Convert all buckets to a single list
    var pairs: jo.List[K ~ V] = []
    var i = 0
    while i < capacity do
      val bucket = buckets[i]
      pairs = pairs ++ bucket
      i = i + 1
    end
    pairs

  //[ Return an iterator over the key-value pairs, in unspecified order. //]
  def iterator: Iterator[K ~ V] = toList.iterator

  //[ Return a string representation, e.g. `{a -> 1, b -> 2}`. Shows at most 100 pairs. //]
  def toString(auto
      keyShow: Show[K] with [[K].toString],
      valueShow: Show[V] with [[V].toString])
  : String =

    // Show at most 100
    var res = "{"
    var count = 0
    val iter = this.iterator
    while count < 100 && iter.hasNext do
      val pair = iter.next()
      val keyText = keyShow.show pair.fst
      val valueText = valueShow.show pair.snd
      if count == 0 then
        res = res + keyText + " -> " + valueText
      else
        res = res + ", " + keyText + " -> " + valueText
      count = count + 1
    end
    if count == 100 then res = res + ", ..."
    res = res + "}"
    res
end
