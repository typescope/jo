namespace jo.mutable

//[ Factory methods for `mutable.Map`. //]
section Map
  //[ Number of slots a new map starts with, before it first grows. //]
  def initialCapacity: Int = 16

  //[ Create an empty map. //]
  def empty[K, V]
      (auto
        eq: Eq[K] with [[K].==],
        hash: Hash[K] with [[K].hashCode]
      )
    : Map[K, V] =

    new Map[K, V]()

  // A chain ends in the sentinel `End` and not in `None`. With `Option`,
  // each link would need a `Some`, so every insert and relink would allocate.
  private[mutable] object End
  end

  private[mutable] class Entry[K, V]
    val key: K
    var value: V
    var next: Entry[K, V] | End

    def Entry(key: K, value: V, next: Entry[K, V] | End) =
      this.key = key
      this.value = value
      this.next = next
  end
end

//[ Create a `mutable.Map` from the given key-value pairs. //]
def Map[K, V](elems: ..Pair[K, V])
    (auto
      eq: Eq[K] with [[K].==],
      hash: Hash[K] with [[K].hashCode])
  : Map[K, V] =

  val m = Map.empty[K, V]
  for a ~ b in elems do
    m.add(a, b)
  end
  m

//[ A mutable hash table with separate chaining.
  !
  ! Lookup, insert, and remove are O(1) on average. The table grows and
  ! rehashes when the load factor exceeds 0.75.
  !
  ! Iteration order is unspecified.
//]
class Map[K, V]
  private val eq: Eq[K]
  private val hash: Hash[K]
  private var buckets: Array[Map.Entry[K, V] | Map.End]
  private var _size: Int

  //[ Create an empty map. Non-positive capacities use one bucket. //]
  def Map(initialCapacity: Int = Map.initialCapacity)
      (auto
        eq: Eq[K] with [[K].==],
        hash: Hash[K] with [[K].hashCode]) =

    val capacity = if initialCapacity > 0 then initialCapacity else 1
    this.buckets = Array.fill[Map.Entry[K, V] | Map.End](capacity, Map.End)
    this._size = 0
    this.eq = eq
    this.hash = hash

  //[ Number of key-value pairs. //]
  def size: Int = _size

  //[ Number of key-value pairs (alias for `size`). //]
  def length: Int = _size

  //[ Is the map empty //]
  def isEmpty: Bool = this._size == 0

  private def capacity: Int = buckets.size

  private def bucketIndexFor(k: K, cap: Int): Int =
    // Spread high bits into the low bits used by power-of-two capacities.
    val h = hash.hashCode(k)
    val spread = h ^ ((h >> 16) & 0xffff)
    (spread & 0x7fffffff) % cap

  private def bucketIndex(k: K): Int =
    bucketIndexFor(k, capacity)

  private def shouldGrow(nextSize: Int): Bool =
    // Grow when load factor exceeds 0.75.
    nextSize * 4 > capacity * 3

  // Return the entry for `k`, or `End` if the key is absent.
  private def find(k: K): Map.Entry[K, V] | Map.End =
    var e = buckets[bucketIndex k]
    while e is cur: Map.Entry[K, V] && !eq.equal(cur.key, k) do
      e = cur.next
    end
    e

  // Link `entry` at the tail of chain `index`, so chains keep insertion order.
  private def append(table: Array[Map.Entry[K, V] | Map.End], index: Int, entry: Map.Entry[K, V]): Unit =
    match table[index]
    case Map.End => table[index] = entry
    case head: Map.Entry[K, V] =>
      var last = head
      while last.next is n: Map.Entry[K, V] do
        last = n
      end
      last.next = entry

  private def rehash(newCapacity: Int): Unit =
    val oldBuckets = buckets
    val newBuckets = Array.fill[Map.Entry[K, V] | Map.End](newCapacity, Map.End)
    var i = 0
    while i < oldBuckets.size do
      var e = oldBuckets[i]
      while e is cur: Map.Entry[K, V] do
        val next = cur.next
        cur.next = Map.End
        append(newBuckets, bucketIndexFor(cur.key, newCapacity), cur)
        e = next
      end
      i = i + 1
    end
    buckets = newBuckets

  //[ True if `k` is bound in the map. //]
  def contains(k: K): Bool = find(k) is _: Map.Entry[K, V]

  //[ Return `Some(v)` if `k` is bound to `v`, `None` otherwise. //]
  def getOpt(k: K): Option[V] =
    match find k
    case e: Map.Entry[K, V] => Some e.value
    case Map.End => None

  //[ Return the value bound to `k`. Aborts if the key is absent. //]
  def get(k: K): V =
    match find k
    case e: Map.Entry[K, V] => e.value
    case Map.End => abort "key not found"

  //[ Return the value bound to `k`, or `default` if the key is absent. //]
  def getOrElse(k: K, default: V): V =
    match find k
    case e: Map.Entry[K, V] => e.value
    case Map.End => default

  //[ Bind `k` to `v` (alias for `update`). //]
  def set(k: K, v: V): Unit = update(k, v)

  //[ Bind `k` to `v`, replacing any existing binding. Amortized O(1).
    !
    ! If `k` is already bound, only the value changes. The map keeps the key
    ! object it stored first.
  //]
  def update(k: K, v: V): Unit =
    match find k
    case e: Map.Entry[K, V] => e.value = v
    case Map.End =>
      if shouldGrow(_size + 1) then rehash(capacity * 2)
      append(buckets, bucketIndex k, new Map.Entry(k, v, Map.End))
      _size = _size + 1

  //[ Bind `k` to `v` (alias for `update`). //]
  def add(k: K, v: V): Unit = update k v

  //[ Add all key-value pairs from `pairs`, replacing existing bindings. //]
  def addAll(pairs: Iterator[K ~ V] :- [.iterator]): Unit =
    while pairs.hasNext do
      val p = pairs.next()
      update p.fst p.snd
    end

  //[ Add all key-value pairs from `pairs` (alias for `addAll`). //]
  def ++=(pairs: Iterator[K ~ V] :- [.iterator]): Unit = addAll pairs

  //[ Remove the binding for `k`. Does nothing if the key is absent. //]
  def remove(k: K): Unit =
    val index = bucketIndex k
    var prev: Map.Entry[K, V] | Map.End = Map.End
    var e = buckets[index]
    var done = false
    while !done && e is cur: Map.Entry[K, V] do
      if eq.equal(cur.key, k) then
        match prev
        case p: Map.Entry[K, V] => p.next = cur.next
        case Map.End => buckets[index] = cur.next
        _size = _size - 1
        done = true
      else
        prev = cur
        e = cur.next
    end

  //[ Remove all bindings. //]
  def clear: Unit =
    var i = 0
    while i < capacity do
      buckets[i] = Map.End
      i = i + 1
    end
    _size = 0

  //[ Reduce to a single value using a left fold with `f: (S, K, V) => S`.
    !
    ! Pairs are visited in unspecified order.
  //]
  def fold[S](zero: S, f: (S, K, V) => S): S =
    var acc = zero
    var i = 0
    while i < capacity do
      var e = buckets[i]
      while e is cur: Map.Entry[K, V] do
        acc = f acc cur.key cur.value
        e = cur.next
      end
      i = i + 1
    end
    acc

  //[ Return all keys as an immutable `List`, in unspecified order. //]
  def keys: jo.List[K] =
    val keys = jo.List.builder[K]()
    var i = 0
    while i < capacity do
      var e = buckets[i]
      while e is cur: Map.Entry[K, V] do
        keys += cur.key
        e = cur.next
      end
      i = i + 1
    end
    keys.result

  //[ Return all values as an immutable `List`, in unspecified order. //]
  def values: jo.List[V] =
    val values = jo.List.builder[V]()
    var i = 0
    while i < capacity do
      var e = buckets[i]
      while e is cur: Map.Entry[K, V] do
        values += cur.value
        e = cur.next
      end
      i = i + 1
    end
    values.result

  //[ Copy all key-value pairs into a new immutable `List`, in unspecified order. //]
  def toList: jo.List[K ~ V] =
    val pairs = jo.List.builder[K ~ V]()
    var i = 0
    while i < capacity do
      var e = buckets[i]
      while e is cur: Map.Entry[K, V] do
        pairs += (cur.key ~ cur.value)
        e = cur.next
      end
      i = i + 1
    end
    pairs.result

  //[ Return an iterator over the key-value pairs, in unspecified order. //]
  def iterator: Iterator[K ~ V] = toList.iterator

  //[ Return a string representation, e.g. `{a -> 1, b -> 2}`. Shows at most 100 pairs. //]
  def toString(auto
      keyShow: Show[K] with [[K].toString],
      valueShow: Show[V] with [[V].toString])
  : String =

    // Show at most 100
    var res = "{"
    var count = 0
    val iter = this.iterator
    while count < 100 && iter.hasNext do
      val pair = iter.next()
      val keyText = keyShow.show pair.fst
      val valueText = valueShow.show pair.snd
      if count == 0 then
        res = res + keyText + " -> " + valueText
      else
        res = res + ", " + keyText + " -> " + valueText
      count = count + 1
    end
    if iter.hasNext then res = res + ", ..."
    res = res + "}"
    res
end
