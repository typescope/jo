namespace jo.runtime.native.BumpAllocator

import jo.runtime.native
import jo.runtime.native.Syscall
import jo.runtime.native.Addr

private[native] def init(): Unit receives none =
  val start = Syscall.sys_brk 0
  val state = native.state

  state.freeFrom = start
  state.freeUntil = start

private[native] def alloc(size: Int): Addr receives none =
  val state = native.state

  var freeFrom = state.freeFrom
  val lastFreeUntil = state.freeUntil

  // Compare differences of addresses, which stay correct where a sum of an
  // address and a large size would wrap. `brk` returns the old break when it
  // fails, so check that the new break leaves room for `size` bytes.
  if size > lastFreeUntil - freeFrom then
     val pages = size / 4096 + 1
     val newFreeUntil = Syscall.sys_brk (lastFreeUntil + pages * 4096)
     if newFreeUntil == -1 || newFreeUntil - lastFreeUntil < size then
       abort "Unable to alloc memory from system"

     // Start the allocation at the newly mapped page boundary.
     freeFrom = lastFreeUntil

     // update data
     state.freeUntil = newFreeUntil

  val res = freeFrom

  val newFreeFrom = freeFrom + size

  // update data
  state.freeFrom = newFreeFrom

  native.intToAddr res
