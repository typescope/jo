namespace jo.runtime.native

//------------------------------------------------------------------------------
//
// String support
//

// A string is a `Raw` or a `Concat`. A `Raw` holds UTF-8 bytes at `content`,
// which points just past the header of a buffer, as every `Addr` field must.
// A `Concat` joins two strings without copying them. Readers work on the
// flat form of a string (see `StringOps.flat`) and read its bytes in place.
private[native] type StringRepr = Raw | Concat

private[native] class Raw(byteSize: Int, cpCount: Int, content: Addr)

// `flat` caches the flat form of the `Concat`. It starts as the `Concat`
// itself, and the first reader replaces it with a `Raw`. So the `Concat` is
// flattened exactly when `flat` is a `Raw`.
private[native] class Concat(byteSize: Int, cpCount: Int, lhs: String, rhs: String)
  var flat: StringRepr = this
end

private[native] section StringOps
  private def utf8SeqLen(firstByte: Byte): Int =
    val b = firstByte.toInt & 0xFF
    if b < 0x80 then 1
    else if b < 0xE0 then 2
    else if b < 0xF0 then 3
    else 4

  def countUtf8CodePoints(content: Addr, byteSize: Int): Int =
    var cp = 0
    var off = 0
    while off < byteSize do
      val step = utf8SeqLen: readByte(addAddr content off)
      off = off + step
      cp = cp + 1
    end
    cp

  private def codePointToByteOffset(content: Addr, byteSize: Int, cpIndex: Int): Int =
    var cp = 0
    var off = 0
    while cp < cpIndex && off < byteSize do
      val step = utf8SeqLen: readByte(addAddr content off)
      off = off + step
      cp = cp + 1
    end
    off

  private def decodeCodePoint(content: Addr, byteOffset: Int): Char =
    val b0 = readByte(addAddr content byteOffset).toInt & 0xFF
    val cp =
      if b0 < 0x80 then
        b0
      else if b0 < 0xE0 then
        val b1 = readByte(addAddr content (byteOffset + 1)).toInt & 0x3F
        ((b0 & 0x1F) << 6) | b1
      else if b0 < 0xF0 then
        val b1 = readByte(addAddr content (byteOffset + 1)).toInt & 0x3F
        val b2 = readByte(addAddr content (byteOffset + 2)).toInt & 0x3F
        ((b0 & 0x0F) << 12) | (b1 << 6) | b2
      else
        val b1 = readByte(addAddr content (byteOffset + 1)).toInt & 0x3F
        val b2 = readByte(addAddr content (byteOffset + 2)).toInt & 0x3F
        val b3 = readByte(addAddr content (byteOffset + 3)).toInt & 0x3F
        ((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3
    cp.toChar

  private def copyBytes(dst: Addr, src: Addr, len: Int): Unit =
    var i = 0
    while i < len do
      writeByte(addAddr dst i, readByte(addAddr src i))
      i = i + 1
    end

  private def sameBytes(a: Addr, b: Addr, len: Int): Bool =
    var i = 0
    while i < len && readByte(addAddr a i) == readByte(addAddr b i) do
      i = i + 1
    end
    i == len

  // Convert a UTF-8 string `[size: Int][bytes]` to a string in place. The
  // 32-bit backends call it for every string literal. Their static data is
  // never traced, so the content need not follow a buffer header.
  def fromByteString(byteArray: Addr): String =
    val byteSize = readInt: byteArray
    val contentAddr = addAddr: byteArray, 4
    val cpCount = countUtf8CodePoints(contentAddr, byteSize)

    cast[String]: Raw(byteSize, cpCount, contentAddr)

  // Copy a UTF-8 string `[size: Int][bytes]` to a new string. The content of
  // the result points just past a buffer header, so a trace of it is valid.
  def copyByteString(byteArray: Addr): String =
    val byteSize = readInt: byteArray
    val buf = allocBuffer byteSize
    copyBytes(buf, addAddr(byteArray, 4), byteSize)
    val cpCount = countUtf8CodePoints(buf, byteSize)

    cast[String]: Raw(byteSize, cpCount, buf)

  // Convert a null-terminated C UTF-8 string pointer to Jo String. On LLVM,
  // `addr` must point just past a buffer header, like any `Addr` field.
  def fromCString(addr: Addr): String =
    var byteSize = 0
    var cur = addr
    while (readByte cur) != 0 do
      byteSize = byteSize + 1
      cur = addAddr addr byteSize
    end

    val cpCount = countUtf8CodePoints(addr, byteSize)
    cast[String]: Raw(byteSize, cpCount, addr)

  def byteSize(repr: String): Int =
    match cast[StringRepr] repr
      case Raw(n, _, _) => n
      case Concat(n, _, _, _) => n

  def size(repr: String): Int =
    match cast[StringRepr] repr
      case Raw(_, n, _) => n
      case Concat(_, n, _, _) => n

  //[ The flat form of a string, whose bytes can be read in place.
    !
    ! Its content must not be written to: other strings share it.
  //]
  def flat(repr: String): Raw =
    match cast[StringRepr] repr
      case r: Raw => r
      case c: Concat => flatten c

  // Flatten `c` once and cache the result in `c.flat`.
  //
  // The buffer and the `Raw` come from the region of the first reader. The
  // store into `c.flat` is a mutation, so the write barrier promotes the
  // `Raw` to the region of `c`. The cleanup of the reader's region then moves
  // the buffer along with it.
  private def flatten(c: Concat): Raw =
    match c.flat
      case r: Raw => r

      case _ =>
        val n = c.byteSize
        val buf = allocBuffer n
        fill(buf, 0, c.lhs, c.rhs)
        val r = Raw(n, c.cpCount, buf)
        c.flat = r
        r

  // Copy the bytes of `lhs + rhs` to `buf` at `start`.
  //
  // A rope built by appends is deep on one side. So recurse into the smaller
  // child of a `Concat` and loop on the larger one. The smaller child has at
  // most half the bytes, and an empty string stops at once, so the recursion
  // is at most about 32 deep.
  private def fill(buf: Addr, start: Int, lhs: String, rhs: String): Unit =
    var at = start
    var left = lhs
    var right = rhs
    var done = false
    while !done do
      val lhsN = byteSize left
      var next = left
      if lhsN <= byteSize(right) then
        fillSmall(buf, at, left)
        at = at + lhsN
        next = right
      else
        fillSmall(buf, at + lhsN, right)

      if copyFlat(buf, at, next) then
        done = true
      else
        val c = cast[Concat] next
        left = c.lhs
        right = c.rhs
    end

  // Copy the bytes of `s` to `buf` at `at`
  private def fillSmall(buf: Addr, at: Int, s: String): Unit =
    if !(copyFlat(buf, at, s)) then
      val c = cast[Concat] s
      fill(buf, at, c.lhs, c.rhs)

  // Copy `s` to `buf` at `at` if it needs no walk: a `Raw`, an empty string
  // or a `Concat` with a cached flat form. Return whether it did.
  private def copyFlat(buf: Addr, at: Int, s: String): Bool =
    match cast[StringRepr] s
      case Raw(n, _, content) =>
        copyBytes(addAddr buf at, content, n)
        true

      case c: Concat =>
        if c.byteSize == 0 then true
        else
          match c.flat
            case r: Raw =>
              copyBytes(addAddr buf at, r.content, c.byteSize)
              true

            case _ => false

  // The most levels a read of one position walks down a rope. A deeper read
  // flattens the rope instead.
  private def descentLimit: Int = 32

  // Code point `i` of `repr`.
  //
  // Walk down to the leaf that holds it: a `Raw` or a `Concat` with a cached
  // flat form. The sizes of the children are known, so a level costs O(1).
  // After an append, a read near the end takes a step or two, so appends and
  // reads can interleave without copying. A read deep in a rope flattens it
  // once, so later reads are O(1). Reads far from the appends, like `s[0]`
  // after each `s = s + c`, still copy the whole string every 32 appends.
  def get(repr: String, i: Int): Char =
    if i >= size(repr) || i < 0 then abort "index out of bound"

    var cur = repr
    var k = i
    var steps = 0
    while true do
      match cast[StringRepr] cur
        case r: Raw => return charAt(r, k)

        case c: Concat =>
          match c.flat
            case r: Raw => return charAt(r, k)

            case _ =>
              if steps == descentLimit then return charAt(flat repr, i)

              val lhsN = size c.lhs
              if k < lhsN then
                cur = c.lhs
              else
                k = k - lhsN
                cur = c.rhs

              steps = steps + 1
    end
    abort "unreachable"

  // Byte `off` of `repr`, found like `get` finds a code point
  private def byteAt(repr: String, off: Int): Byte =
    var cur = repr
    var k = off
    var steps = 0
    while true do
      match cast[StringRepr] cur
        case r: Raw => return readByte(addAddr r.content k)

        case c: Concat =>
          match c.flat
            case r: Raw => return readByte(addAddr r.content k)

            case _ =>
              if steps == descentLimit then return readByte(addAddr (flat repr).content off)

              val lhsN = byteSize c.lhs
              if k < lhsN then
                cur = c.lhs
              else
                k = k - lhsN
                cur = c.rhs

              steps = steps + 1
    end
    abort "unreachable"

  private def charAt(r: Raw, i: Int): Char =
    if r.byteSize == r.cpCount then
      (readByte(addAddr r.content i).toInt & 0xFF).toChar
    else
      val off = codePointToByteOffset(r.content, r.byteSize, i)
      decodeCodePoint(r.content, off)

  // The byte size of a string is an `Int`, and `flat` allocates it in one
  // buffer. A wrapped sum would allocate too little, so abort instead. The
  // code point count is at most the byte size, so it cannot wrap either.
  def (lhs: String) + (rhs: String): String =
    val lhsN = byteSize lhs
    val rhsN = byteSize rhs
    if lhsN > 2147483647 - rhsN then
      abort "String of \{lhsN} + \{rhsN} bytes is too large"

    val cpN = lhs.size + rhs.size
    cast[String] Concat(lhsN + rhsN, cpN, lhs, rhs)

  def (lhs: String) == (rhs: String): Bool =
    val bytesN = byteSize(lhs)
    if bytesN != byteSize(rhs) || lhs.size != rhs.size then false
    else if sameRef(lhs, rhs) then true
    else sameBytes((flat lhs).content, (flat rhs).content, bytesN)

  def substring(source: String, from: Int, len: Int): String =
    val cpN = source.size
    if from < 0 then abort "from should not be negative"
    if len < 0 then abort "len should not be negative"
    // `from + len` could wrap, so compare with the room left after `from`
    if from > cpN || len > cpN - from then abort "substring out of range"

    if len == 0 then ""
    else
      val r = flat source
      if len == cpN then cast[String] r
      else
        val content = r.content
        val totalByteN = r.byteSize
        val startByte =
          if totalByteN == cpN then from
          else codePointToByteOffset(content, totalByteN, from)
        val endByte =
          if totalByteN == cpN then from + len
          else codePointToByteOffset(content, totalByteN, from + len)
        val subByteN = endByte - startByte
        val buf = allocBuffer subByteN
        copyBytes(buf, addAddr(content, startByte), subByteN)
        cast[String] Raw(subByteN, len, buf)

  // Compare the bytes of `other` at each code point from `from`. In UTF-8,
  // equal bytes from a code point boundary are equal code points.
  def indexOf(source: String, other: String, from: Int): Int =
    val n = source.size
    val m = other.size
    var start = from
    if start < 0 then start = 0
    if start > n then start = n

    if m == 0 then start
    else if m > n - start then -1
    else
      val s = flat source
      val o = flat other
      val content = s.content
      val sN = s.byteSize
      val oN = o.byteSize
      val ascii = sN == n
      var off = if ascii then start else codePointToByteOffset(content, sN, start)
      var result = -1
      var i = start
      while result < 0 && i <= n - m do
        if oN <= sN - off && sameBytes(addAddr content off, o.content, oN) then
          result = i
        else
          off = off + (if ascii then 1 else utf8SeqLen(readByte(addAddr content off)))
          i = i + 1
      end
      result

  // An argument of at most this many bytes is compared with `byteAt`, which
  // reads near an edge of a rope without flattening it
  private def shortLimit: Int = 32

  // Whether `n` bytes of `s` from `at` equal the first `n` bytes of `t`
  private def sameBytesAt(s: String, at: Int, t: String, n: Int): Bool =
    var i = 0
    while i < n && byteAt(s, at + i) == byteAt(t, i) do
      i = i + 1
    end
    i == n

  def startsWith(source: String, prefix: String): Bool =
    val sN = byteSize source
    val pN = byteSize prefix
    if prefix.size > source.size || pN > sN then false
    else if pN <= shortLimit then sameBytesAt(source, 0, prefix, pN)
    else sameBytes((flat source).content, (flat prefix).content, pN)

  def endsWith(source: String, suffix: String): Bool =
    val sN = byteSize source
    val xN = byteSize suffix
    if suffix.size > source.size || xN > sN then false
    else if xN <= shortLimit then sameBytesAt(source, sN - xN, suffix, xN)
    else sameBytes(addAddr((flat source).content, sN - xN), (flat suffix).content, xN)

  // Change the ASCII letters from `first` to `first + 25` by `delta`. Other
  // code points keep their bytes, since in UTF-8 every byte of a multi-byte
  // code point is at least 0x80.
  private def mapLetters(source: String, first: Int, delta: Int): String =
    val r = flat source
    val n = r.byteSize
    if n == 0 then ""
    else
      val buf = allocBuffer n
      var i = 0
      while i < n do
        val b = readByte(addAddr r.content i).toInt & 0xFF
        val c = if b >= first && b <= first + 25 then b + delta else b
        writeByte(addAddr buf i, c.toByte)
        i = i + 1
      end
      cast[String] Raw(n, r.cpCount, buf)

  def toLower(source: String): String = mapLetters(source, 65, 32)

  def toUpper(source: String): String = mapLetters(source, 97, -32)

  def iterator(source: String): Iterator[Char] =
    new StringIterator(source)

  //[ The bytes of a string, read in place. Callers must not write to them. //]
  def bytes(repr: String): Addr = (flat repr).content
end

// `content` points just past the header of the buffer of the flat form, so
// it keeps the buffer alive.
private[native] class StringIterator(source: String)
  val content: Addr = StringOps.bytes(source)
  val byteN: Int = StringOps.byteSize(source)
  var off: Int = 0

  def hasNext: Bool = off < byteN

  def next: Char =
    if off >= byteN then abort "String iterator exhausted"

    val b0 = readByte(addAddr content off).toInt & 0xFF
    var cp: Int = -1
    var step: Int = -1
    if b0 < 0x80 then
      cp = b0
      step = 1
    else if b0 < 0xE0 then
      val b1 = readByte(addAddr content (off + 1)).toInt & 0x3F
      cp = ((b0 & 0x1F) << 6) | b1
      step = 2
    else if b0 < 0xF0 then
      val b1 = readByte(addAddr content (off + 1)).toInt & 0x3F
      val b2 = readByte(addAddr content (off + 2)).toInt & 0x3F
      cp = ((b0 & 0x0F) << 12) | (b1 << 6) | b2
      step = 3
    else
      val b1 = readByte(addAddr content (off + 1)).toInt & 0x3F
      val b2 = readByte(addAddr content (off + 2)).toInt & 0x3F
      val b3 = readByte(addAddr content (off + 3)).toInt & 0x3F
      cp = ((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3
      step = 4
    end

    off = off + step
    cp.toChar

  view Iterator[Char]
end
