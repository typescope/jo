namespace jo.runtime.native

import jo.compile.intrinsic

import jo.runtime.native.GC
import jo.runtime.native.ParamSupport


//------------------------------------------------------------------------------
//
// Utilities
//

type Addr

@intrinsic
private def writeInt(arr: Addr, value: Int): Unit receives none =
  abort "native writeInt"

@intrinsic
private def readInt(arr: Addr): Int =
  abort "native readInt"

//[ The caller needs to make sure the value fit into one byte
  !
//]
@intrinsic
private def writeByte(arr: Addr, value: Byte): Unit receives none =
  abort "native writeInt"

@intrinsic
private def readByte(arr: Addr): Byte receives none =
  abort "native readByte"

@intrinsic
private def addAddr(arr: Addr, offset: Int): Addr receives none =
  abort "native addAddr"

//[ cast a type to a non-primitive type
  !
//]
@intrinsic
def cast[T](arr: Any): T receives none = abort("runtime cast")

//[ Read a word-sized address //]
@intrinsic
private def readAddr(arr: Addr): Addr receives none =
  abort "native readAddr"

//[ Write a word-sized address //]
@intrinsic
private def writeAddr(arr: Addr, value: Addr): Unit receives none =
  abort "native writeAddr"

//[ The null address //]
@intrinsic
private def nullAddr: Addr receives none =
  abort "native nullAddr"

//[ Whether a reference is null //]
@intrinsic
private def isNull(ref: Any): Bool receives none =
  abort "native isNull"

//[ Whether two references point to the same address //]
@intrinsic
private def sameRef(a: Any, b: Any): Bool receives none =
  abort "native sameRef"

//[ The size of a machine word in bytes
  !
  ! Heap slots, array elements and interface table entries are one word each.
//]
@intrinsic
private def wordSize: Int receives none =
  abort "native wordSize"

private def debug(s: String): Unit receives none =
  writeString: 0, cast[StringRepr] s
  writeString: 0, cast[StringRepr] "\n"

//------------------------------------------------------------------------------
//
// Interface runtime support
//

//[ Stub function for EncodeClass phase to retrieve interface table address
  !
  ! The backend intrinsifies this call to a static address.
//]
@intrinsic
private def getInterfaceTable(classId: Int): Addr receives none = ...

//[ Whether a value is a lambda
  !
  ! Used by pattern matching to test the lambda branch of a union type. The
  ! backend lowers this call to a test on the class id of `ClosureTag`.
//]
@intrinsic
private def isLambdaValue(v: Any): Bool receives none = ...

//[ The class id tag of closures
  !
  ! A closure is encoded as `{ cid, apply, underlying }`, where `cid` is the
  ! class id of this class. It distinguishes closures from class instances at
  ! runtime. The class is never instantiated.
//]
private class ClosureTag

//[ Find a method pointer in an interface table
  !
  ! Interface table structure:
  !   [count, iid1, vtable_ptr1, iid2, vtable_ptr2, ...]
  !
  ! Vtable structure:
  !   [method_ptr1, method_ptr2, ...]
  !   (no count - compiler knows the correct method index)
  !
  ! Returns the method pointer as an Int (address)
//]
private def findInterfaceMethod(itableAddr: Addr, interfaceId: Int, methodOrder: Int): Addr receives none =
  // Check if itable is null (no interfaces implemented)
  if isNull itableAddr then
    abort "Interface not implemented (null itable)"

  // Read number of interfaces
  val count = readInt itableAddr

  // Linear search through interface table. Each entry is a word.
  // The interface ID of entry `index` is at word 1 + index * 2.
  var index = 0
  while index < count && (readInt (addAddr itableAddr ((1 + index * 2) * wordSize))) != interfaceId do
    index = index + 1

  if index == count then
    abort "Interface not implemented (not found in itable)"

  // The vtable pointer follows the interface ID
  val vtablePtr = readAddr (addAddr itableAddr ((2 + index * 2) * wordSize))

  // Read method from vtable (no bounds check - trust compiler)
  readAddr (addAddr vtablePtr (methodOrder * wordSize))

//------------------------------------------------------------------------------
//
// Primitive operators for numeric types (Int, Byte, Char, Float)
//
// These are wrappers that will be inlined by the backends

private section IntOps
  @intrinsic def (a: Int) + (b: Int): Int = abort "native Int.+"
  @intrinsic def (a: Int) - (b: Int): Int = abort "native Int.-"
  @intrinsic def (a: Int) * (b: Int): Int = abort "native Int.*"
  @intrinsic def (a: Int) / (b: Int): Int = abort "native Int./"
  @intrinsic def (a: Int) % (b: Int): Int = abort "native Int.%"
  @intrinsic def (a: Int) > (b: Int): Bool = abort "native Int.>"
  @intrinsic def (a: Int) < (b: Int): Bool = abort "native Int.<"
  @intrinsic def (a: Int) >= (b: Int): Bool = abort "native Int.>="
  @intrinsic def (a: Int) <= (b: Int): Bool = abort "native Int.<="
  @intrinsic def (a: Int) == (b: Int): Bool = abort "native Int.=="
  @intrinsic def (a: Int) != (b: Int): Bool = abort "native Int.!="
  @intrinsic def (a: Int) >> (b: Int): Int = abort "native Int.>>"
  @intrinsic def (a: Int) << (b: Int): Int = abort "native Int.<<"
  @intrinsic def (a: Int) & (b: Int): Int = abort "native Int.&"
  @intrinsic def (a: Int) | (b: Int): Int = abort "native Int.|"
  @intrinsic def (a: Int) ^ (b: Int): Int = abort "native Int.^"
  @intrinsic def (a: Int) toChar: Char = abort "native Int.toChar"
  @intrinsic def (a: Int) toByte: Byte = abort "native Int.toByte"
  @intrinsic def (a: Int) toFloat: Float = abort "native Int.toFloat"
  def (a: Int) toLong: Long = intToLong a
  @intrinsic def ~- (a: Int): Int = abort "native Int.~-"
  @intrinsic def ~~ (a: Int): Int = abort "native Int.~~"
  def (a: Int) toString: String = intToStr a
end

private section ByteOps
  // Byte operators (via numeric coercion to Int)
  @intrinsic def (a: Byte) == (b: Byte): Bool = abort "native Byte.=="
  @intrinsic def (a: Byte) != (b: Byte): Bool = abort "native Byte.!="
  @intrinsic def (a: Byte) > (b: Byte): Bool = abort "native Byte.>"
  @intrinsic def (a: Byte) < (b: Byte): Bool = abort "native Byte.<"
  @intrinsic def (a: Byte) >= (b: Byte): Bool = abort "native Byte.>="
  @intrinsic def (a: Byte) <= (b: Byte): Bool = abort "native Byte.<="
  @intrinsic def (a: Byte) toInt: Int = abort "native Byte.toInt"
  @intrinsic def (a: Byte) toChar: Char = abort "native Byte.toChar"
  @intrinsic def (a: Byte) toFloat: Float = abort "native Byte.toFloat"
  def (a: Byte) toLong: Long = intToLong a.toInt
  def (a: Byte) toString: String = intToStr (a.toInt)
end

private section CharOps
  // Char operators (via numeric coercion to Int)
  @intrinsic def (a: Char) == (b: Char): Bool = abort "native Char.=="
  @intrinsic def (a: Char) != (b: Char): Bool = abort "native Char.!="
  @intrinsic def (a: Char) > (b: Char): Bool = abort "native Char.>"
  @intrinsic def (a: Char) < (b: Char): Bool = abort "native Char.<"
  @intrinsic def (a: Char) >= (b: Char): Bool = abort "native Char.>="
  @intrinsic def (a: Char) <= (b: Char): Bool = abort "native Char.<="
  @intrinsic def (a: Char) toByte: Byte = abort "native Char.toByte"
  @intrinsic def (a: Char) toInt: Int = abort "native Char.toInt"
  @intrinsic def (a: Char) toFloat: Float = abort "native Char.toFloat"
  def (a: Char) toLong: Long = intToLong a.toInt
  def (a: Char) toString: String = charToStr a
end

private section BoolOps
  @intrinsic def (a: Bool) && (b: Bool): Bool = abort "native Bool.&&"
  @intrinsic def (a: Bool) || (b: Bool): Bool = abort "native Bool.||"
  @intrinsic def (a: Bool) == (b: Bool): Bool = abort "native Bool.=="
  @intrinsic def (a: Bool) != (b: Bool): Bool = abort "native Bool.!="
  @intrinsic def ~! (a: Bool): Bool = abort "native Bool.~!"
  def (a: Bool) toString: String =
    if a then "true" else "false"
end

private section FloatOps
  // Float operators (Double precision floating-point)
  @intrinsic def (a: Float) + (b: Float): Float = abort "native Float.+"
  @intrinsic def (a: Float) - (b: Float): Float = abort "native Float.-"
  @intrinsic def (a: Float) * (b: Float): Float = abort "native Float.*"
  @intrinsic def (a: Float) / (b: Float): Float = abort "native Float./"
  @intrinsic def (a: Float) > (b: Float): Bool = abort "native Float.>"
  @intrinsic def (a: Float) < (b: Float): Bool = abort "native Float.<"
  @intrinsic def (a: Float) >= (b: Float): Bool = abort "native Float.>="
  @intrinsic def (a: Float) <= (b: Float): Bool = abort "native Float.<="
  @intrinsic def (a: Float) == (b: Float): Bool = abort "native Float.=="
  @intrinsic def (a: Float) != (b: Float): Bool = abort "native Float.!="
  @intrinsic def ~- (a: Float): Float = abort "native Float.~-"
  @intrinsic def (a: Float) toInt: Int = abort "native Float.toInt"
  @intrinsic def (a: Float) truncateToLong: Long = abort "native Float.truncateToLong"
  @intrinsic def (a: Float) floorFinite: Float = abort "native Float.floorFinite"
  @intrinsic def (a: Float) toBits: Long = abort "native Float.toBits"
  def (a: Float) toString: String = floatToStr a
end

//------------------------------------------------------------------------------
//
// Boxing support for numeric types in union types
//
// These wrapper classes are used by the native backend to box numeric types
// when they are used in union types. This enables runtime type discrimination.
//

private class BoolBox(value: Bool)
private class ByteBox(value: Byte)
private class CharBox(value: Char)
private class IntBox(value: Int)
private class FloatBox(value: Float)

//[ Stub to call a synthesized function at backend to do actual initialization
  !
  ! The target function can only be synthesized after traversing the whole
  ! universe of reachable objects.
//]
@intrinsic
private def initObjects(): Unit receives none = ...

//------------------------------------------------------------------------------
//
// Predef implementation
//

private def abortImpl(msg: String): Bottom receives none =
  writeString: 2, cast[StringRepr] msg
  exitImpl 1

//------------------------------------------------------------------------------
//
// Numeric types to string
//

private def charToStr(c: Char): String =
  val codePoint = c.toInt

  // Determine UTF-8 byte length based on code point value
  val len =
    if codePoint <= 0x7F then 1
    else if codePoint <= 0x7FF then 2
    else if codePoint <= 0xFFFF then 3
    else 4

  val content = allocBuffer len

  // Encode code point to UTF-8
  if codePoint <= 0x7F then
    // 1-byte: 0xxxxxxx
    writeByte content codePoint.toByte
  else if codePoint <= 0x7FF then
    // 2-byte: 110xxxxx 10xxxxxx
    writeByte content (0xC0 | (codePoint >> 6)).toByte
    writeByte (addAddr content 1) (0x80 | (codePoint & 0x3F)).toByte
  else if codePoint <= 0xFFFF then
    // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
    writeByte content (0xE0 | (codePoint >> 12)).toByte
    writeByte (addAddr content 1) (0x80 | ((codePoint >> 6) & 0x3F)).toByte
    writeByte (addAddr content 2) (0x80 | (codePoint & 0x3F)).toByte
  else
    // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    writeByte content (0xF0 | (codePoint >> 18)).toByte
    writeByte (addAddr content 1) (0x80 | ((codePoint >> 12) & 0x3F)).toByte
    writeByte (addAddr content 2) (0x80 | ((codePoint >> 6) & 0x3F)).toByte
    writeByte (addAddr content 3) (0x80 | (codePoint & 0x3F)).toByte

  cast[String]: Raw(len, 1, content)

private def intToStr(n: Int): String =
  // MAX_VALUE =  2147483647
  // MIN_VALUE = -2147483648
  if n == 0 then "0"
  else if n == -2147483648 then "-2147483648" // its negation is still negative
  else
    // memory allocator will handle alignment
    val buf = allocBuffer 11 // max 11

    val negative = n < 0
    var remains = if negative then 0 - n else n

    // write from end of buffer
    var index = 10
    while remains > 0 do
      val digit = remains % 10
      writeByte:
        addAddr buf index
        (48 + digit).toByte // '0' = 48

      index = index - 1
      remains = remains / 10

    // sign char
    if negative then
      writeByte (addAddr buf index) 45 // '-' = 45
      index = index - 1

    val startIndex = index + 1
    val len = 10 - index

    // copy bytes to front
    if startIndex > 0 then
      var copyIndex = 0
      while copyIndex < len do
        val c = readByte (addAddr buf (startIndex + copyIndex))
        writeByte (addAddr buf copyIndex) c
        copyIndex = copyIndex + 1

    cast[String]: Raw(len, len, buf)

//------------------------------------------------------------------------------
//
// Array support
//
// A native array is represented as follows, where W is the word size:
//
//    0       W       2W             2W + size * W
//    ┌───────┬───────┬──────────────────────┐
//    │ cid   │ size  │  content             │
//    └───────┴───────┴──────────────────────┘
//
// The class id (cid) makes it possible to tell an array value from class
// instances. Each element takes one word.

// List claims (see `jo.ListImpl.Claim`)
//
// The native runtime runs a single thread.
//

// How far a shared array is taken.
private class ClaimState
  var used: Int

  def ClaimState(used: Int) =
    this.used = used
end

private section ListClaim
  def newClaim(used: Int): ListImpl.Claim receives none =
    cast[ListImpl.Claim](new ClaimState(used))

  def tryExtend(claim: ListImpl.Claim, stop: Int, count: Int): Bool receives none =
    val state = cast[ClaimState](claim)

    if state.used == stop then
      state.used = stop + count
      true
    else
      false
end

// Bytes operations. Bytes.Repr is an Addr to a `[cid: word][size: word][bytes...]`
// block. The leading `cid` word is `bytesClassId`, which the LLVM garbage
// collector reads to find the layout. The 32-bit platform writes 0. The bytes
// start at offset `contentOffset`.

// Offset of the content of arrays and bytes: after the cid and size words
private def contentOffset: Int = 2 * wordSize

// Check that `count` elements of `unit` bytes, after the cid and size words,
// fit in an `Int` allocation size. A wrapped size would allocate too little.
private def checkAllocCount(count: Int, unit: Int): Unit =
  if count < 0 || count > (2147483647 - contentOffset) / unit then
    abort "Allocation of \{count} elements is negative or too large"

private def base64Char(v: Int): Int =
  if v < 26 then 65 + v               // 'A'..'Z'
  else if v < 52 then 97 + (v - 26)   // 'a'..'z'
  else if v < 62 then 48 + (v - 52)   // '0'..'9'
  else if v == 62 then 43             // '+'
  else 47                             // '/'

private section RawBytes
  def size(repr: Bytes.Repr): Int = readInt (addAddr (cast[Addr] repr) wordSize)

  def get(repr: Bytes.Repr, index: Int): Byte =
    val n = size repr
    assert: index >= 0 && index < n, "Index \{index} out of bounds, size = \{n}"
    readByte (addAddr (cast[Addr] repr) (index + contentOffset))

  def slice(repr: Bytes.Repr, offset: Int, length: Int): Bytes =
    val n = size repr
    assert:
      offset >= 0 && length >= 0 && offset <= n - length
      "Slice at \{offset} of length \{length} out of bounds, size = \{n}"

    val src = cast[Addr] repr
    val start = contentOffset
    val dst = GC.alloc (length + start)
    writeInt dst bytesClassId
    writeInt (addAddr dst wordSize) length

    var i = 0
    while i < length do
      writeByte (addAddr dst (i + start)) (readByte (addAddr src (offset + start + i)))
      i = i + 1

    cast[Bytes] dst

  def toBase64(repr: Bytes.Repr): String =
    val src = cast[Addr] repr
    val n = readInt (addAddr src wordSize)
    val content = addAddr src contentOffset
    val outLen = ((n + 2) / 3) * 4

    val out = allocBuffer outLen

    var i = 0
    var o = 0
    while i < n do
      val b0 = (readByte (addAddr content i)).toInt & 0xFF
      val b1 = if i + 1 < n then (readByte (addAddr content (i + 1))).toInt & 0xFF else 0
      val b2 = if i + 2 < n then (readByte (addAddr content (i + 2))).toInt & 0xFF else 0
      val triple = (b0 << 16) | (b1 << 8) | b2

      writeByte (addAddr out o)       (base64Char ((triple >> 18) & 0x3F)).toByte
      writeByte (addAddr out (o + 1)) (base64Char ((triple >> 12) & 0x3F)).toByte
      writeByte (addAddr out (o + 2)) (if i + 1 < n then base64Char ((triple >> 6) & 0x3F) else 61).toByte
      writeByte (addAddr out (o + 3)) (if i + 2 < n then base64Char (triple & 0x3F) else 61).toByte

      i = i + 3
      o = o + 4

    // Base64 is ASCII: one code point per byte
    cast[String]: Raw(outLen, outLen, out)

  def fill(size: Int, values: Int => Byte): Bytes =
    checkAllocCount(size, 1)
    val start = contentOffset
    val dst = GC.alloc (size + start)
    writeInt dst bytesClassId
    writeInt (addAddr dst wordSize) size

    var i = 0
    while i < size do
      writeByte (addAddr dst (i + start)) (values(i))
      i = i + 1

    cast[Bytes] dst
end

private section RefArray
  @intrinsic
  def ArrayClassId: Int = ...

  def create[T](size: Int): Array[T] =
    checkAllocCount(size, wordSize)
    val arr = GC.alloc (size * wordSize + contentOffset)
    writeInt arr ArrayClassId
    writeInt:
      addAddr arr wordSize
      size

    cast[Array[T]] arr

  def get[T](arr: Array[T], i: Int): T =
    assert: i >= 0 && i < arr.size, "Index \{i} out of bounds, size = \{arr.size}"
    val addr = readAddr:
      addAddr:
        cast[Addr] arr
        i * wordSize + contentOffset

    cast[T]: addr

  def clear[T](arr: Array[T], i: Int): Unit =
    assert: i >= 0 && i < arr.size, "Index \{i} out of bounds, size = \{arr.size}"
    writeRef(cast[Addr] arr, i * wordSize + contentOffset, nullAddr)

  def set[T](arr: Array[T], i: Int, value: T): Unit =
    assert: i >= 0 && i < arr.size, "Index \{i} out of bounds, size = \{arr.size}"
    writeRef(cast[Addr] arr, i * wordSize + contentOffset, cast[Addr] value)

  def size[T](arr: Array[T]): Int =
    readInt: addAddr (cast[Addr] arr) wordSize

  def clone[T](arr: Array[T]): Array[T] =
    val n = size arr
    val arr2 = create[T] n
    var i = 0
    while i < n do
      arr2[i] = arr[i]
      i = i + 1
    end
    arr2
end


//------------------------------------------------------------------------------
//
// I/O support
//

private def writeString(fd: Int, repr: StringRepr): Unit =
  match repr
    case Raw(byteN, _, content) =>
      val bytesWritten = writeFd fd content byteN
      assert:
        byteN == bytesWritten
        "write failed"

    case Concat(_, _, lhs, rhs) =>
      writeString:
        fd
        cast[StringRepr] lhs

      writeString:
        fd
        cast[StringRepr] rhs


private def createStdOut(): String => Unit =
  (s: String) => writeString: 1, cast[StringRepr] s

private def createStdErr(): String => Unit =
  (s: String) => writeString: 2, cast[StringRepr] s
