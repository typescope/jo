namespace jo.jvm

import jo.compile.intrinsic

//[ The JVM null reference.
  !
  ! The JVM backend emits `aconst_null`. The value is intended for reference
  ! positions.
//]
@intrinsic
def null: Bottom = ...

//[ Whether a value is the JVM null reference. //]
@intrinsic
def isNull(value: Any): Bool = ...

//[ JVM reference identity comparison. //]
@intrinsic
def refEq(left: Any, right: Any): Bool = ...
