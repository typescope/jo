namespace gcplacewrapper

// Wrappers of `a[i] = v`. A function is an element store when it always
// stores one of its parameters into another, like `Array.set`.
//
// `put` and `store` are element stores, `store` with its parameters in
// another order, and `checked` stores after an `assert`. `putTwice` wraps
// `store`, and `putNext` stores at a computed index. `putIf` stores inside an
// `if`, `putEarly` may return before its store, and `putOther` stores a local,
// not its parameter, so none of them is an element store. Every builder must
// give the same trees, whether its subtrees are placed or traced.

union Tree = Inner(children: Array[Tree]) | Leaf(n: Int)

def put(a: Array[Tree], i: Int, v: Tree): Unit =
  a[i] = v

def store(v: Tree, i: Int, a: Array[Tree]): Unit =
  put(a, i, v)

def checked(a: Array[Tree], i: Int, v: Tree): Unit =
  assert: i < 4, "index \{i}"
  store(v, i, a)

def putTwice(a: Array[Tree], i: Int, v: Tree): Unit =
  store(v, i, a)
  store(v, i, a)

def putIf(a: Array[Tree], i: Int, v: Tree): Unit =
  if i >= 0 then a[i] = v

def putOther(a: Array[Tree], i: Int, v: Tree): Unit =
  var w = v
  if i == 3 then w = Leaf(7)
  a[i] = w

def putNext(a: Array[Tree], i: Int, v: Tree): Unit =
  a[i + 1] = v

def putEarly(a: Array[Tree], i: Int, v: Tree): Unit =
  if i < 0 then return
  a[i] = v

def build(depth: Int, k: Int): Tree =
  if depth == 1 then Leaf(depth + k)
  else
    val children: Array[Tree] = Array.fill(4, Leaf(0))
    var i = 0
    while i < 4 do
      val child = build(depth - 1, k)
      if k == 0 then put(children, i, child)
      else if k == 1 then store(child, i, children)
      else if k == 2 then checked(children, i, child)
      else if k == 3 then putTwice(children, i, child)
      else if k == 4 then putIf(children, i, child)
      else if k == 5 then putOther(children, i, child)
      else if k == 6 then putNext(children, i - 1, child)
      else putEarly(children, i, child)
      i = i + 1
    end
    Inner(children)

def sum(t: Tree): Int =
  match t
    case Inner(cs) =>
      var s = 1
      var i = 0
      while i < cs.size do
        s = s + sum(cs[i])
        i = i + 1
      end
      s
    case Leaf(n) => n

def main(): Unit =
  var k = 0
  while k < 8 do
    var total = 0
    var r = 0
    while r < 20 do
      total = total + sum(build(7, k))
      r = r + 1
    end
    println: total
    k = k + 1
  end
