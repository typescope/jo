def main =
  testCompareTo()
  testCodePointComparison()

def testCompareTo =
  println "--- compareTo ---"

  println "abc".compareTo("abc")          // 0
  println "abc".compareTo("abd")          // -1
  println "abd".compareTo("abc")          // 1
  println "ab".compareTo("abc")           // -1
  println "abc".compareTo("ab")           // 1
  println "\u{4F60}".compareTo("\u{597D}") // -2589 (你 vs 好)
  println "\u{1F680}".compareTo("\u{1F389}") // 759 (🚀 vs 🎉)

  println "--- set/map ---"

  val s = Set("b", "a", "\u{4F60}")
  println s.contains("a")                 // true
  println s.contains("z")                 // false
  println s.size                          // 3

  val m = Map("b" ~ 2, "a" ~ 1, "\u{4F60}" ~ 3)
  println m.contains("a")                 // true
  println m.contains("\u{597D}")          // false
  println m.get("a")                      // 1
  println m.get("\u{4F60}")               // 3
  println m.size                          // 3

// Preserve exact code point differences and prefix ordering on every backend.
def testCodePointComparison =
  println "".compareTo("")
  println "same".compareTo("same")
  println "a".compareTo("z")
  println "z".compareTo("a")
  println "".compareTo("abc")
  println "abc".compareTo("")
  println "abc".compareTo("abcdef")
  println "abcdef".compareTo("abc")
  println "a\u{0}b".compareTo("a\u{0}d")
  println "é".compareTo("ê")
  println "é\u{1F600}".compareTo("é\u{1F680}")
  println "\u{10000}".compareTo("\u{FFFF}")
  println "é".compareTo("é\u{1F600}\u{1F680}")
  println "é\u{1F600}\u{1F680}".compareTo("é")
  println "\u{FFFF}".compareTo("\u{10000}")
  println "\u{1F600}".compareTo("\u{1F600}")
  println "\u{1F600}a".compareTo("\u{1F600}z")
  println "".compareTo("\u{1F600}\u{1F680}")
  println "\u{1F600}\u{1F680}".compareTo("")
  println "a".compareTo("é")
  println "\u{7FF}".compareTo("\u{800}")
  println "\u{4F60}".compareTo("\u{4F61}")
  println "\u{1F600}".compareTo("\u{1F601}")

  // Ordering synthesized from compareTo must use the same implementation.
  println List("z", "a", "é", "a", "").sort
