def main =
  testStartsWith()

def testStartsWith =
  println "--- startsWith ---"

  println "hello world".startsWith("hello")    // true
  println "hello world".startsWith("world")    // false
  println "hello world".startsWith("")         // true
  println "hi".startsWith("hello")             // false

  // Unicode
  val cn = "\u{4F60}\u{597D}\u{4E16}\u{754C}"
  println cn.startsWith("\u{4F60}\u{597D}")    // true
  println cn.startsWith("\u{4E16}")            // false

  // Emoji
  val s = "\u{1F680}abc"
  println s.startsWith("\u{1F680}")            // true
  println s.startsWith("a")                   // false

  // Empty strings, exact matches, and a mismatch after a shared prefix.
  println "".startsWith("")                   // true
  println "".startsWith("a")                  // false
  println "hello".startsWith("hello")         // true
  println "hello".startsWith("help")          // false
  println "ababc".startsWith("abc")           // false, despite a later match

  // Preserve code point boundaries and embedded NUL characters.
  println "é\u{1F680}abc".startsWith("é\u{1F680}a") // true
  println "é\u{1F680}".startsWith("é\u{1F680}a")    // false
  println "\u{1F680}a".startsWith("\u{1F681}")     // false
  println "a\u{0}b".startsWith("a\u{0}")           // true
  println "a\u{0}b".startsWith("a\u{0}c")          // false

