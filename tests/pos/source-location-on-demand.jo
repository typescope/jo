import jo.compile.SourceLocation

def forwarded()(auto location: SourceLocation): String = location.toString

def main: Unit =
  println compile.location.toString
  println forwarded()
  println (new SourceLocation("generated.jo", 42)).toString

  assert(true, compile.location.toString)
  assert(true, message())

  auto overridden: SourceLocation = new SourceLocation("overridden.jo", 99)
  println compile.location.toString
  println forwarded()
  println "passed"

def message(): String =
  println compile.location.toString
  abort("message evaluated")
