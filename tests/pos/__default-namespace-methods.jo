// Exercise class and singleton methods with a double-underscore filename.
def greeting(value: String): String = "hello from " + value

class Box(value: String)
  def text: String = greeting(value)
  def copy: Box = new Box(value)
end

object Empty
  def box: Box = new Box("singleton")
end

def main(): Unit =
  println((new Box("lib")).copy.text)
  println(Empty.box.text)
