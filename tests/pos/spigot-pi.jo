// Spigot algorithm for Pi (Rabinowitz & Wagon)
def spigotPi(digits: Int): List[Int] =
  val guardDigits = 10
  val len = (10 * (digits + guardDigits) / 3) + 1
  val a = Array.create[Int](len)
  var init = 0
  while init < len do
    a[init] = 2
    init = init + 1
  var result: List[Int] = []
  var nines = 0
  var predigit = 0

  for j in 1 to (digits + guardDigits) do
    var q = 0
    var i = len - 1
    while i >= 0 do
      val num = a[i] * 10 + q * (i + 1)
      val denom = 2 * i + 1
      a[i] = num % denom
      q = num / denom
      i = i - 1

    a[0] = q % 10
    q = q / 10

    if q == 9 then
      nines = nines + 1
    else if q == 10 then
      result = result + (predigit + 1)
      for k in 1 to nines do
        result = result + 0
      predigit = 0
      nines = 0
    else
      result = result + predigit
      predigit = q
      for k in 1 to nines do
        result = result + 9
      nines = 0

  result = result + predigit
  result.drop(1).take(digits)

def main(): Unit receives IO.stdout =
  // The units digit followed by 100 digits after the decimal point.
  println spigotPi(101).join("")
