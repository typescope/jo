class Key(value: Int)
  def ==(other: Key): Bool = this.value == other.value

class Own
  def ==(other: Own): Bool = true
  def !=(other: Own): Bool = true

class GenericEquality
  def ==[T](other: T): Bool = false

class Loud
  def ==(other: Loud): Bool =
    println "equality effect"
    true

class Box[T](value: T)
  def ==(other: Box[T])(auto eq: Eq[T] with [[T].==]): Bool =
    eq.equal(value, other.value)

class Probe(value: Int, trace: Array[Int])
  def ==(other: Probe): Bool =
    trace[0] = trace[0] * 10 + 3
    value == other.value

def probe(value: Int, step: Int, trace: Array[Int]): Probe =
  trace[0] = trace[0] * 10 + step
  new Probe(value, trace)

def contextualEquality =
  auto alwaysEqual: Eq[Key] = (a, b) => true
  val a = new Key(1)
  val b = new Key(2)
  assert(a != b, "whole-type Eq does not replace the equality method")
  assert(!(new Box(a) != new Box(b)), "equality method resolves its own autos")

def customOperator =
  def (a: Key) != (b: Key): Bool = false
  assert(!(new Key(1) != new Key(2)), "a different global operator is not intrinsified")

def main =
  val one = new Key(1)
  assert(!(one != new Key(1)), "equal values")
  assert(one != new Key(2), "different values")
  assert(new Own() != new Own(), "explicit inequality takes precedence")
  assert(new GenericEquality() != new GenericEquality(), "polymorphic equality method")
  assert(!(new Loud() != new Loud()), "equality effects are propagated")
  assert(new Box(1) != new Box(2), "synthesized component equality")
  assert(!(new Box(new Box(1)) != new Box(new Box(1))), "nested equality autos")

  val trace = Array.fill(1, 0)
  assert(probe(1, 1, trace) != probe(2, 2, trace), "effectful comparison")
  assert(trace[0] == 123, "left, right, and equality evaluated once in order")

  contextualEquality()
  customOperator()
  println "intrinsic not-equals: OK"
