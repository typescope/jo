// A lambda converted to an interface at a *primitive* type needs no bridge.
//
// `isTagged(Int)` differs from `isTagged(Any)`, so when `Erasure` adapts the
// lambda to the interface's erased SAM, `adaptLambdaValue` reshapes it into
// interface form. The class `ElimCapture` then lifts already matches the
// interface, and no bridge is required.
//
// This passes under either position of `InterfaceBridge` relative to
// `ElimCapture`. Its counterpart bridge-lifted-interface-ref.jo uses
// `Ord[String]`, where tagging matches and the reshaping does not happen —
// that one does need a bridge, and shows the orderings apart.

interface Ord[T]
  def compare(a: T, b: T): Int
end

def minBy(a: Int, b: Int, o: Ord[Int]): Int =
  if o.compare(a, b) < 0 then a else b

def main: Unit =
  println minBy(3, 7, (a, b) => a - b)
