namespace memapp

import jo.mutable

// `remember` stores a new node into an array created by `main`, so each node
// is promoted to the runtime region by a store. `note` does the same through
// the library: the store in `List.append`, called by `List.+=`, is charged to
// `append`, and its caller is `note`. `accumulate` builds a list in its own
// region, which holds all the nodes at once until it returns. The last loop
// of `main` allocates in its region, and `Iterator.fold` builds a long list in
// the region of the library function.
//
// Under the default policy, `main` opens a region like any other function,
// and the containers are in it. Under `--region-policy none`, `main` runs in
// the runtime region.

class Node(value: Int, next: Option[Node])

def remember(nodes: Array[Node], i: Int): Unit =
  nodes[i] = new Node(i, None)

def note(log: mutable.List[Node], i: Int): Unit =
  log += new Node(i, None)

def accumulate(n: Int): Int =
  var list: Option[Node] = None
  var i = 0
  while i < n do
    list = Some(new Node(i, list))
    i = i + 1
  end

  length list

def length(list: Option[Node]): Int =
  var count = 0
  var cur = list
  var done = false
  while !done do
    match cur
      case Some(node) =>
        count = count + 1
        cur = node.next

      case None => done = true
  end
  count

def main =
  val nodes = Array.create[Node](5000)
  var i = 0
  while i < 5000 do
    remember(nodes, i)
    i = i + 1
  end

  val log = new mutable.List[Node]
  i = 0
  while i < 3000 do
    note(log, i)
    i = i + 1
  end

  println: accumulate 5000

  var last = new Node(0, None)
  i = 0
  while i < 3000 do
    last = new Node(i, Some(last))
    i = i + 1
  end

  println: log.size + last.value

  val folded = (0 until 5000).iterator.fold(new Node(0, None), (acc, k) => new Node(k, Some(acc)))
  println: length(Some(folded))
