namespace memapp

// `remember` stores a new node into an array created by `main`, so each node
// is promoted to the runtime region by a store. `accumulate` builds a list in
// its own region, which holds all the nodes at once until it returns.

class Node(value: Int, next: Option[Node])

def remember(nodes: Array[Node], i: Int): Unit =
  nodes[i] = new Node(i, None)

def accumulate(n: Int): Int =
  var list: Option[Node] = None
  var i = 0
  while i < n do
    list = Some(new Node(i, list))
    i = i + 1
  end

  length list

def length(list: Option[Node]): Int =
  var count = 0
  var cur = list
  var done = false
  while !done do
    match cur
      case Some(node) =>
        count = count + 1
        cur = node.next

      case None => done = true
  end
  count

def main =
  val nodes = Array.create[Node](5000)
  var i = 0
  while i < 5000 do
    remember(nodes, i)
    i = i + 1
  end

  println: accumulate 5000
