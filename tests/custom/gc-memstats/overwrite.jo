namespace memoverwrite

// A loop overwrites the one slot of the array it returns a million times.
// The array is in the region of `last`, and the store promotes each node
// there. The overwritten nodes stay until `last` returns: about 40 MB. This
// is the limitation of a value replaced in an object created before the
// loop.

class Node(v: Int)

// Overwrites the one slot of the array it returns
def last(n: Int): Array[Node] =
  val best = Array.fill(1, new Node(0))
  var i = 0
  while i < n do
    best[0] = new Node(i)
    i = i + 1
  end
  best

def main(): Unit =
  var total = 0
  var k = 0
  while k < 5 do
    total = total + last(1000000)[0].v
    k = k + 1
  end
  println: total
