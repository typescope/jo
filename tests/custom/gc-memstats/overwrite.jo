namespace memoverwrite

// A loop overwrites the one slot of the array it returns a million times.
// The stored nodes are placed in the region of `main`, which keeps the
// overwritten ones until the region of the iteration of `main` closes after
// the call. The first iteration runs in the region of `main` itself, so its
// nodes stay until `main` returns: about 80 MB in all. This is a limitation
// of placing what is stored into the result.

class Node(v: Int)

// Overwrites the one slot of the array it returns
def last(n: Int): Array[Node] =
  val best = Array.fill(1, new Node(0))
  var i = 0
  while i < n do
    best[0] = new Node(i)
    i = i + 1
  end
  best

def main(): Unit =
  var total = 0
  var k = 0
  while k < 5 do
    total = total + last(1000000)[0].v
    k = k + 1
  end
  println: total
