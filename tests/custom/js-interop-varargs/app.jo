@js.interop
interface PathModule
  def join(parts: ..String): String
end

def main: Unit =
  testPositionalVarargs()
  testPositionalSplice()

def testPositionalVarargs: Unit =
  println "--- ..T positional ---"
  val path: PathModule = js.require("path").cast[PathModule]
  println path.join("tmp", "a", "b")

def testPositionalSplice: Unit =
  println "--- ..T splice ---"
  val path: PathModule = js.require("path").cast[PathModule]
  val segs: List[String] = List("x", "y")
  println path.join(..segs)
  println (path.join(..segs, "z"))
  println (path.join(..segs, ..segs))
  println (path.join(..segs, "z", ..segs, "w"))
  println (path.join("root", ..segs))
  val builder = List.builder[String]().add("b").add("c")
  println (path.join(..builder.result))
  println (path.join(..(PartSource + "u")))

object PartSource
  def +(part: String): List[String] = [part]
end
