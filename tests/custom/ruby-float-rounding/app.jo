def main =
  for value in [(-0.0).round, (-0.0).floor, (-0.0).ceil, (-0.25).round, (-0.25).ceil, (-5.0e-324).round, (-5.0e-324).ceil] do
    val checked = rb.dynamic(value).asFloat
    assert(1.0 / checked < 0.0, "negative zero")
  end

  for value in [(0.0).round, (0.0).floor, (0.0).ceil, (0.25).round, (0.25).floor, (5.0e-324).round, (5.0e-324).floor] do
    val checked = rb.dynamic(value).asFloat
    assert(1.0 / checked > 0.0, "positive zero")
  end

  for value in [(2.7).round, (2.7).floor, (2.7).ceil] do
    assert(rb.dynamic(value).asFloat > 0.0, "Float result")
  end

  println "rounding representation passed"
