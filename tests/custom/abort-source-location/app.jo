import jo.compile.SourceLocation

def fail()(auto location: SourceLocation): Bottom =
  abort("forwarded abort")

def check()(auto location: SourceLocation): Unit =
  assert(false, "forwarded assertion (" + location + ")")

def nestedCheck()(auto location: SourceLocation): Unit = check()

def overridden(): Unit =
  auto location: SourceLocation = new SourceLocation("generated.jo", 99)
  check()

def missing()(auto location: SourceLocation): Bottom = ...

def countdown(n: Int)(auto location: SourceLocation): Bottom =
  if n == 0 then abort("tailrec abort")
  else countdown(n - 1)

def main: Unit =
  match IO.args[0]
    case "abort" => abort("direct abort")
    case "assert" => assert(false, "direct assertion (" + jo.compile.location + ")")
    case "forward-abort" => fail()
    case "forward-assert" => nestedCheck()
    case "override" => overridden()
    case "placeholder" => ...
    case "forward-placeholder" => missing()
    case "tailrec" => countdown(3)
    case "plain-abort" => abort("plain abort")
    case "plain-assert" => assert(false, "plain assertion")
    case "lazy" =>
      assert(true, () => abort("message evaluated"))
      println("passed")
    case _ => abort("unknown test")
