
def main =
  testImportAndSelect()
  testCallDynamic()
  testUpdateDynamic()
  testBracketAccess()
  testCast()
  testDynamic()
  testChainedAccess()
  testCallWithKwarg()
  testCallWithSplice()
  testCheckedAccessors()
  testLongAccessor()
  testConversions()

//[ 1. importModule + selectDynamic (attribute read) //]
def testImportAndSelect =
  println "--- importModule + selectDynamic ---"
  val math: py.Dynamic = py.module("math")
  val pi: Float = math.pi.asFloat
  println("pi = " + pi.toString)

  // inf and nan are also module-level attributes
  val e: Float = math.e.asFloat
  println("e > 2.7 = " + (e > 2.7).toString)

//[ 2. callDynamic: method call on py.Dynamic //]
def testCallDynamic =
  println "--- callDynamic ---"
  val math: py.Dynamic = py.module("math")

  val floor: Int = math.floor(2.7).asInt
  println("floor(2.7) = " + floor.toString)

  val ceil: Int = math.ceil(2.1).asInt
  println("ceil(2.1) = " + ceil.toString)

  val sqrt: Float = math.sqrt(9.0).asFloat
  println("sqrt(9) = " + sqrt.toString)

  val builtins: py.Dynamic = py.module("builtins")
  val absResult: Int = builtins.abs(-42).asInt
  println("abs(-42) = " + absResult.toString)

//[ 3. updateDynamic: attribute write on py.Dynamic //]
def testUpdateDynamic =
  println "--- updateDynamic ---"
  val os: py.Dynamic = py.module("os")
  os.custom_attr = "hello"
  val attr: String = os.custom_attr.asString
  println("attr = " + attr)

  os.counter = 42
  val counter: Int = os.counter.asInt
  println("counter = " + counter.toString)

//[ 4. Bracket access: getDynamic and setDynamic via get/set on py.Dynamic //]
def testBracketAccess =
  println "--- bracket access ---"
  val builtins: py.Dynamic = py.module("builtins")
  val d: py.Dynamic = builtins.dict()

  // Write via bracket syntax
  d["x"] = 42
  d["y"] = "hello"

  // Read via bracket syntax
  val x: Int = d["x"].asInt
  val y: String = d["y"].asString
  println("dict[x] = " + x.toString)
  println("dict[y] = " + y)

  // Integer key
  val lst: py.Dynamic = builtins.list()
  lst.append(10)
  lst.append(20)
  lst.append(30)
  val item: Int = lst[1].asInt
  println("list[1] = " + item.toString)

//[ 5. cast[T]: type assertion //]
def testCast =
  println "--- cast ---"
  val math: py.Dynamic = py.module("math")

  // cast to Float
  val pi: Float = math.pi.asFloat
  println("pi cast Float = " + pi.toString)

  // cast to Int (floor result)
  val floor: Int = math.floor(3.9).asInt
  println("floor(3.9) cast Int = " + floor.toString)

  // cast to String
  val builtins: py.Dynamic = py.module("builtins")
  val s: String = builtins.str(42).asString
  println("str(42) = " + s)

//[ 6. dynamic: convert any value to py.Dynamic //]
def testDynamic =
  println "--- dynamic ---"
  // py.dynamic can convert a typed python value back to py.Dynamic for dynamic access
  val math: py.Dynamic = py.module("math")
  val pi: Float = math.pi.asFloat

  // Re-wrap a Python float back as py.Dynamic to read attributes dynamically
  val piVal: py.Dynamic = py.dynamic(pi)
  // On a Python float, 'real' gives the value itself
  val real: Float = piVal.real.asFloat
  println("pi.real = " + real.toString)

//[ 7. Chained dynamic access //]
def testChainedAccess =
  println "--- chained access ---"
  val os: py.Dynamic = py.module("os")

  // os.path.join(a, b) — three dynamic accesses chained
  val joined: String = os.path.join("/tmp", "test").asString
  println("joined = " + joined)

  // os.path.sep — attribute access
  val sep: String = os.path.sep.asString
  println("sep = " + sep)

//[ 8. callDynamic with kwarg markers //]
def testCallWithKwarg =
  println "--- callDynamic + kwarg ---"
  val string: py.Dynamic = py.module("string")

  // capwords("jo-ffi", sep="-")
  val result: String = string.capwords("jo-ffi", sep = "-").asString
  println("capwords = " + result)

//[ 9. callDynamic with splice //]
def testCallWithSplice =
  println "--- callDynamic + splice ---"
  val builtins: py.Dynamic = py.module("builtins")

  // max(*[1, 7, 3]) = 7 via native splice
  val maxResult: Int = builtins.max(..[1, 7, 3]).asInt
  println("max(*[1,7,3]) = " + maxResult.toString)

//[ 10. Primitive accessors reject values of the wrong Python type //]
def testCheckedAccessors =
  println "--- checked accessors ---"
  val builtins: py.Dynamic = py.module("builtins")

  match py.try(builtins.str("not an int").asInt)
    case Ok(_)  => println "asInt unexpectedly accepted str"
    case Err(e) => println e.message

  match py.try(builtins.int(1).asFloat)
    case Ok(_)  => println "asFloat unexpectedly accepted int"
    case Err(e) => println e.message

  match py.try(builtins.bool(true).asInt)
    case Ok(_)  => println "asInt unexpectedly accepted bool"
    case Err(e) => println e.message

  match py.try(builtins.int(1).asBool)
    case Ok(_)  => println "asBool unexpectedly accepted int"
    case Err(e) => println e.message

  match py.try(builtins.int(1).asString)
    case Ok(_)  => println "asString unexpectedly accepted int"
    case Err(e) => println e.message

//[ 11. Long access preserves integer precision and rejects other Python types //]
def testLongAccessor =
  println "--- Long accessor ---"
  val builtins: py.Dynamic = py.module("builtins")

  for text in ["0", "2147483648", "-2147483649", "9007199254740993", "9223372036854775807", "-9223372036854775808"] do
    val value: Long = builtins.int(text).asLong
    println value
  end

  val wide: Long = builtins.int("4294967296").asLong
  println (wide >> 32)

  match py.try(builtins.str("42").asLong)
    case Ok(_)  => println "asLong unexpectedly accepted str"
    case Err(e) => println e.message

  match py.try(builtins.float(42).asLong)
    case Ok(_)  => println "asLong unexpectedly accepted float"
    case Err(e) => println e.message

  match py.try(builtins.bool(true).asLong)
    case Ok(_)  => println "asLong unexpectedly accepted bool"
    case Err(e) => println e.message

//[ 12. Conversion helpers follow Python builtin semantics //]
def testConversions =
  println "--- Python conversions ---"
  val parsed: Int = py.int("42").asInt
  println parsed
  val wide: Long = py.int("9007199254740993").asLong
  println wide
  val huge: py.Dynamic = py.int("18446744073709551616")
  println huge
  println py.int(3.9).asInt
  println py.int(-3.9).asInt
  println py.int(true).asInt

  val fraction: Float = py.float("3.5")
  println fraction
  println (py.float(42) == 42.0)

  val truth: Bool = py.bool("false")
  println truth
  println py.bool("")
  println py.bool(0)
  println py.bool(-1)
  println py.bool(py.none)
  println py.bool(py.list())
  println py.bool(py.list(0))

  match py.try(py.int("not an int"))
    case Ok(_)  => println "int unexpectedly accepted invalid text"
    case Err(e) => println e.typeName

  match py.try(py.float("not a float"))
    case Ok(_)  => println "float unexpectedly accepted invalid text"
    case Err(e) => println e.typeName
