;;; emacs.el --- Jo highlighting regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'json)
(require 'jo-mode)

(defun jo-test-position (text)
  "Return the start of TEXT in the current buffer."
  (goto-char (point-min))
  (search-forward text)
  (- (point) (length text)))

(ert-deftest jo-shared-highlighting-fixtures ()
  (let* ((json-object-type 'alist)
         (json-array-type 'list)
         (fixtures (json-read-file (getenv "JO_HIGHLIGHT_FIXTURES"))))
    (dolist (fixture fixtures)
      (with-temp-buffer
        (insert (alist-get 'source fixture))
        (jo-mode)
        (font-lock-ensure)
        (dolist (check (alist-get 'checks fixture))
          (goto-char (point-min))
          (forward-line (1- (alist-get 'line check)))
          (search-forward (alist-get 'text check) (line-end-position))
          (let* ((position (+ (- (point) (length (alist-get 'text check)))
                              (or (alist-get 'offset check) 0)))
                 (state (syntax-ppss position))
                 (actual (cond ((nth 4 state) "comment")
                               ((nth 3 state) "string")
                               (t "code")))
                 (expected (alist-get 'kind check)))
            (ert-info ((format "%s:%s: %s" (alist-get 'name fixture)
                               (alist-get 'line check) (alist-get 'text check)))
              (should (equal expected actual))
              (when (equal expected "comment")
                (should (eq (get-text-property position 'face) 'font-lock-comment-face))))))))))

(ert-deftest jo-comment-delimiter-edits ()
  (with-temp-buffer
    (insert "///[\ninside\n///]\ndef after = 42")
    (jo-mode)
    (font-lock-ensure)
    (should-not (nth 4 (syntax-ppss (jo-test-position "after"))))
    (goto-char (point-min))
    (insert "/")
    (font-lock-ensure)
    (should (nth 4 (syntax-ppss (jo-test-position "after"))))
    (should (eq (get-text-property (jo-test-position "after") 'face) 'font-lock-comment-face))
    (delete-region (point-min) (1+ (point-min)))
    (font-lock-ensure)
    (should-not (nth 4 (syntax-ppss (jo-test-position "after"))))
    (should-not (eq (get-text-property (jo-test-position "after") 'face) 'font-lock-comment-face))))

(ert-deftest jo-string-delimiter-edits ()
  (with-temp-buffer
    (insert "val text = \"\"\"\ninside\n\"\"\"\ndef after = 42")
    (jo-mode)
    (font-lock-ensure)
    (should-not (nth 3 (syntax-ppss (jo-test-position "after"))))
    (goto-char (jo-test-position "\"\"\""))
    (insert "\"")
    (font-lock-ensure)
    (should (nth 3 (syntax-ppss (jo-test-position "after"))))
    (should (eq (get-text-property (jo-test-position "after") 'face) 'font-lock-string-face))
    (goto-char (jo-test-position "\"\"\"\""))
    (delete-char 1)
    (font-lock-ensure)
    (should-not (nth 3 (syntax-ppss (jo-test-position "after"))))
    (should-not (eq (get-text-property (jo-test-position "after") 'face) 'font-lock-string-face))))

(ert-deftest jo-regex-comment-markers ()
  (with-temp-buffer
    (insert "val pattern = `//[\"text\"`\n//[ documentation\ninside\n//]\ndef after = 42")
    (jo-mode)
    (font-lock-ensure)
    (should (nth 3 (syntax-ppss (jo-test-position "text"))))
    (should (nth 4 (syntax-ppss (jo-test-position "inside"))))
    (should-not (nth 4 (syntax-ppss (jo-test-position "after"))))))

(ert-deftest jo-regex-flags-highlighting ()
  (with-temp-buffer
    (insert "val pattern = `(?i)text`")
    (jo-mode)
    (font-lock-ensure)
    (should (eq (get-text-property (jo-test-position "(?i)") 'face) 'font-lock-builtin-face))))
