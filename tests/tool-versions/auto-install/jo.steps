rm -rf compilers active

# Install and activate a published version in one command.
jo versions use 0.10.0
: '
Installing Jo 0.10.0 ... done
Now using Jo 0.10.0
'

jo versions list
: '
Installed:

  0.10.0 (active)

Available:

  0.10.1
  0.10.0
'

# An installed version is activated without reinstalling it.
jo versions use 0.10.0
: '
Now using Jo 0.10.0
'

jo versions use 0.10.1
: '
Installing Jo 0.10.1 ... done
Now using Jo 0.10.1
'

# An unknown version must not change the active compiler.
jo versions use 9.9.9
: '
Installing Jo 9.9.9 ...
error: version 9.9.9 not found
'

jo versions list
: '
Installed:

  0.10.1 (active)
  0.10.0

Available:

  0.10.1
  0.10.0
'

rm -rf compilers active
